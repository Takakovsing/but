    document.head.appendChild(style);

    const gui = document.createElement("div");
    gui.id = "pgFloat";
    gui.innerHTML = `
        <div id="pgHead">
            <span class="pgStar">✦</span>
            <span>PORTUGA IA</span>
            <span class="pgStar">✦</span>
            <button id="pgEditApi" type="button" title="Alterar API Key"
                aria-label="Alterar API Key">✎</button>
        </div>
        <div id="pgLine"></div>
        <button id="pgNivel">NÍVEL: MÉDIO</button>
        <button id="pgGerar">✧ GERAR REDAÇÃO</button>
        <div id="pgFoot">INTELIGÊNCIA ARTIFICIAL</div>
    `;
    document.body.appendChild(gui);

    const toggle = document.createElement("button");
    toggle.id = "pgToggle";
    toggle.type = "button";
    toggle.setAttribute("aria-label", "Abrir ou minimizar PORTUGA IA");
    toggle.innerHTML = `
        <img alt="PORTUGA IA"
        src="https://media.tenor.com/m11vauEEbcUAAAAM/meow-neko-arc.gif">
    `;
    document.body.appendChild(toggle);

    const notifyBox = document.createElement("div");
    notifyBox.id = "pgNotify";
    document.body.appendChild(notifyBox);

    function notify(msg, persist = false) {
        notifyBox.textContent = msg;
        notifyBox.style.opacity = "1";
        notifyBox.style.transform = "translate(-50%,0) scale(1)";

        clearTimeout(notifyTimer);

        if (!persist) {
            notifyTimer = setTimeout(() => {
                notifyBox.style.opacity = "0";
                notifyBox.style.transform =
                    "translate(-50%,-15px) scale(.97)";
            }, 2800);
        }
    }

    function animarToggle() {
        toggle.classList.remove("pgPop");
        void toggle.offsetWidth;
        toggle.classList.add("pgPop");
    }

    function definirMinimizado(valor) {
        minimized = Boolean(valor);
        gui.classList.toggle("pgMini", minimized);

        if (minimized) animarToggle();
    }

    function definirGeracao(ativa) {
        toggle.classList.toggle("pgWorking", ativa);
    }

    $("pgEditApi").addEventListener("pointerdown", e => {
        e.stopPropagation();
    });

    $("pgEditApi").addEventListener("click", e => {
        e.stopPropagation();

        const novaChave = prompt(
            "Alterar API Key\n\n" +
            "Cole sua chave da OpenRouter (sk-or-v1-...) " +
            "ou da OpenAI (sk-...)."
        );

        if (!novaChave || !novaChave.trim()) return;

        apiKey = novaChave.trim();
        notify("API Key alterada nesta sessão!");
    });

    $("pgNivel").addEventListener("click", () => {
        nivel = niveis[(niveis.indexOf(nivel) + 1) % niveis.length];
        $("pgNivel").textContent = "NÍVEL: " + nomesNivel[nivel];
        notify("Nível selecionado: " + nomesNivel[nivel]);
    });

    function lerPagina() {
        const clone = document.body.cloneNode(true);

        [
            "#pgFloat", "#pgToggle", "#pgNotify",
            "script", "style", "noscript"
        ].forEach(selector => {
            clone.querySelectorAll(selector).forEach(el => el.remove());
        });

        return (clone.innerText || "")
            .replace(/\n{3,}/g, "\n\n")
            .trim()
            .slice(0, 30000);
    }

    function acharCampo() {
        const seletores = [
            'textarea[name*="redac" i]',
            'textarea[id*="redac" i]',
            'textarea[placeholder*="redac" i]',
            'textarea[placeholder*="escreva" i]',
            'textarea[placeholder*="digite" i]',
            'textarea[placeholder*="resposta" i]'
        ];

        for (const selector of seletores) {
            try {
                const el = document.querySelector(selector);
                if (el && el.getClientRects().length &&
                    !el.disabled && !el.readOnly) return el;
            } catch (_) {}
        }

        const areas = [...document.querySelectorAll("textarea")]
            .filter(el => el.getClientRects().length &&
                !el.disabled && !el.readOnly);

        if (areas.length) {
            return areas.sort((a, b) =>
                b.clientWidth * b.clientHeight -
                a.clientWidth * a.clientHeight
            )[0];
        }

        return [...document.querySelectorAll('[contenteditable="true"]')]
            .find(el => el.getClientRects().length) || null;
    }

    function aplicarTexto(campo, texto) {
        campo.focus();

        if (campo instanceof HTMLTextAreaElement ||
            campo instanceof HTMLInputElement) {
            const proto = campo instanceof HTMLTextAreaElement
                ? HTMLTextAreaElement.prototype
                : HTMLInputElement.prototype;

            const setter = Object.getOwnPropertyDescriptor(proto, "value").set;
            setter.call(campo, texto);
            campo.dispatchEvent(new Event("input", { bubbles: true }));
            campo.dispatchEvent(new Event("change", { bubbles: true }));
        } else {
            campo.replaceChildren();

            texto.split(/\n{2,}/).forEach(paragrafo => {
                const p = document.createElement("p");
                p.textContent = paragrafo;
                campo.appendChild(p);
            });

            campo.dispatchEvent(new InputEvent("input", {
                bubbles: true,
                inputType: "insertText",
                data: texto
            }));
        }
    }

    function identificarProvedor(chave) {
        return /^sk-or-v1-/i.test(chave) ? "openrouter" : "openai";
    }

    function erroApi(mensagem, codigo) {
        const erro = new Error(mensagem);
        erro.codigoApi = codigo;
        return erro;
    }

    async function gerarRedacao(chave, pageText) {
        const provedor = identificarProvedor(chave);

        const endpoint = provedor === "openrouter"
            ? "https://openrouter.ai/api/v1/chat/completions"
            : "https://api.openai.com/v1/chat/completions";

        const modelo = provedor === "openrouter"
            ? "openrouter/auto"
            : "gpt-4o-mini";

        let response;

        try {
            response = await fetch(endpoint, {
                method: "POST",
                headers: {
                    "Authorization": "Bearer " + chave,
                    "Content-Type": "application/json",
                    ...(provedor === "openrouter"
                        ? { "X-OpenRouter-Title": "PORTUGA IA" }
                        : {})
                },
                body: JSON.stringify({
                    model: modelo,
                    messages: [
                        {
                            role: "system",
                            content:
                                "Você é especialista em redações escolares em português. " +
                                "Identifique o tema do material e escreva uma redação original, " +
                                "coerente e adequada ao nível solicitado. " +
                                descNivel[nivel] +
                                " Responda apenas com a redação, sem comentários adicionais. " +
                                "Separe os parágrafos com uma linha em branco."
                        },
                        {
                            role: "user",
                            content: "Material da atividade:\n\n" + pageText
                        }
                    ],
                    temperature: 0.7,
                    max_tokens: 2500
                })
            });
        } catch (_) {
            throw erroApi(
                "Falha de conexão. Verifique a internet e tente novamente.",
                "CONEXAO"
            );
        }

        let dados;

        try {
            dados = await response.json();
        } catch (_) {
            throw erroApi("A API retornou uma resposta inválida.", "RESPOSTA");
        }

        if (!response.ok || dados.error) {
            console.error("Erro da API:", dados);

            const erro = dados?.error || {};
            const mensagem = String(
                erro.message || dados?.message || "Erro HTTP " + response.status
            );

            const textoErro =
                (mensagem + " " + String(erro.code || erro.type || "")).toLowerCase();

            if (
                response.status === 401 ||
                /invalid_api_key|incorrect api key|invalid.*key|authentication/i
                    .test(textoErro)
            ) {
                throw erroApi("A chave da API é inválida ou foi recusada.", "CHAVE_INVALIDA");
            }

            if (
                response.status === 402 ||
                /insufficient_quota|quota.*(exceed|exhaust|insufficient)|billing|credit balance|credits exhausted|payment required|spend limit|monthly limit|out of credits|no credits/i
                    .test(textoErro)
            ) {
                throw erroApi("O saldo ou a cota dessa API acabou.", "COTA");
            }

            if (response.status === 429) {
                throw erroApi(
                    "Limite temporário de requisições atingido. Aguarde e tente novamente. " +
                    mensagem,
                    "RATE_LIMIT"
                );
            }

            if (/user safety|safety|moderation|content.filter/i.test(mensagem)) {
                throw erroApi(
                    "O provedor ou modelo recusou a solicitação por uma regra de segurança. " +
                    "Detalhe: " + mensagem,
                    "SEGURANCA"
                );
            }

            throw erroApi(mensagem, "OUTRO");
        }

        let texto = dados?.choices?.[0]?.message?.content;

        if (Array.isArray(texto)) {
            texto = texto.map(item =>
                typeof item === "string" ? item : item?.text || ""
            ).join("\n");
        }

        if (typeof texto !== "string" || !texto.trim()) {
            throw erroApi("O modelo não retornou uma redação.", "SEM_TEXTO");
        }

        return texto
            .replace(/^```[\w-]*\s*/, "")
            .replace(/\s*```$/, "")
            .trim();
    }

    async function solicitarChave(motivo) {
        const mensagem = motivo === "COTA"
            ? "O saldo ou a cota da chave atual acabou."
            : "A chave atual foi recusada.";

        const entrada = prompt(
            mensagem +
            "\n\nCole outra API Key da OpenRouter (sk-or-v1-...) " +
            "ou da OpenAI (sk-...)."
        );

        if (!entrada || !entrada.trim()) {
            throw erroApi("Troca de API cancelada.", "CANCELADO");
        }

        apiKey = entrada.trim();
    }

    $("pgGerar").addEventListener("click", async () => {
        if (busy) return;

        const campo = acharCampo();

        if (!campo) {
            alert("Não encontrei um campo de texto editável nesta página.");
            return;
        }

        const pageText = lerPagina();

        if (!pageText) {
            alert("Não consegui ler o conteúdo da página.");
            return;
        }

        if (!apiKey) {
            const entrada = prompt(
                "Cole sua API Key da OpenRouter ou da OpenAI:"
            );

            if (!entrada || !entrada.trim()) return;
            apiKey = entrada.trim();
        }

        busy = true;

        const btn = $("pgGerar");
        btn.disabled = true;
        btn.textContent = "GERANDO REDAÇÃO...";
        definirGeracao(true);
        notify("A IA está preparando sua redação...", true);

        try {
            let texto;
            let tentativas = 0;

            while (true) {
                try {
                    texto = await gerarRedacao(apiKey, pageText);
                    break;
                } catch (erro) {
                    const podeTrocar =
                        erro.codigoApi === "COTA" ||
                        erro.codigoApi === "CHAVE_INVALIDA";

                    if (!podeTrocar || tentativas >= 2) throw erro;

                    tentativas++;
                    notify("É necessário trocar a API Key.", true);
                    await solicitarChave(erro.codigoApi);
                    notify("Nova chave inserida. Tentando novamente...", true);
                }
            }

            btn.textContent = "PREENCHENDO...";
            aplicarTexto(campo, texto);
            notify("Redação gerada e preenchida com sucesso!");
        } catch (erro) {
            console.error("[PORTUGA IA]", erro);

            if (erro.codigoApi === "CANCELADO") {
                notify("Troca de API cancelada.");
            } else {
                notify("Não foi possível gerar a redação.");

                alert(
                    "Erro ao gerar redação:\n\n" +
                    (erro?.message || "Erro desconhecido") +
                    "\n\nConfira a chave, a cota e o modelo."
                );
            }
        } finally {
            busy = false;
            btn.disabled = false;
            btn.textContent = "✧ GERAR REDAÇÃO";
            definirGeracao(false);
        }
    });

    toggle.addEventListener("pointerdown", e => {
        if (e.button !== undefined && e.button !== 0) return;

        togglePointer = {
            id: e.pointerId,
            x: e.clientX,
            y: e.clientY,
            left: toggle.getBoundingClientRect().left,
            top: toggle.getBoundingClientRect().top,
            moved: false
        };

        try {
            toggle.setPointerCapture(e.pointerId);
        } catch (_) {}

        e.preventDefault();
    });

    toggle.addEventListener("pointermove", e => {
        if (!togglePointer || togglePointer.id !== e.pointerId) return;

        const dx = e.clientX - togglePointer.x;
        const dy = e.clientY - togglePointer.y;

        if (Math.abs(dx) > 5 || Math.abs(dy) > 5) {
            togglePointer.moved = true;
        }

        if (!togglePointer.moved) return;

        const left = Math.max(
            4,
            Math.min(
                window.innerWidth - toggle.offsetWidth - 4,
                togglePointer.left + dx
            )
        );

        const top = Math.max(
            4,
            Math.min(
                window.innerHeight - toggle.offsetHeight - 4,
                togglePointer.top + dy
            )
        );

        toggle.style.left = left + "px";
        toggle.style.top = top + "px";
        toggle.style.right = "auto";
        toggle.style.bottom = "auto";
    });

    toggle.addEventListener("pointerup", e => {
        if (!togglePointer || togglePointer.id !== e.pointerId) return;

        const arrastou = togglePointer.moved;
        togglePointer = null;

        if (!arrastou) definirMinimizado(!minimized);
    });

    toggle.addEventListener("pointercancel", () => {
        togglePointer = null;
    });

    const head = $("pgHead");

    head.addEventListener("pointerdown", e => {
        if (e.button !== undefined && e.button !== 0) return;
        if (e.target.closest("#pgEditApi")) return;

        const rect = gui.getBoundingClientRect();

        panelDrag = {
            id: e.pointerId,
            x: e.clientX,
            y: e.clientY,
            left: rect.left,
            top: rect.top
        };

        gui.style.left = rect.left + "px";
        gui.style.top = rect.top + "px";
        gui.style.transform = "none";

        try {
            head.setPointerCapture(e.pointerId);
        } catch (_) {}

        e.preventDefault();
    });

    head.addEventListener("pointermove", e => {
        if (!panelDrag || panelDrag.id !== e.pointerId) return;

        const dx = e.clientX - panelDrag.x;
        const dy = e.clientY - panelDrag.y;

        gui.style.left = Math.max(
            4,
            Math.min(
                window.innerWidth - gui.offsetWidth - 4,
                panelDrag.left + dx
            )
        ) + "px";

        gui.style.top = Math.max(
            4,
            Math.min(
                window.innerHeight - gui.offsetHeight - 4,
                panelDrag.top + dy
            )
        ) + "px";
    });

    function pararArrastePainel() {
        panelDrag = null;
    }

    head.addEventListener("pointerup", pararArrastePainel);
    head.addEventListener("pointercancel", pararArrastePainel);

    window.addEventListener("resize", () => {
        const limitar = elemento => {
            const rect = elemento.getBoundingClientRect();

            elemento.style.left = Math.max(
                4,
                Math.min(window.innerWidth - rect.width - 4, rect.left)
            ) + "px";

            elemento.style.top = Math.max(
                4,
                Math.min(window.innerHeight - rect.height - 4, rect.top)
            ) + "px";
        };

        if (gui.style.transform === "none") limitar(gui);
        if (toggle.style.left) limitar(toggle);
    });

    document.addEventListener("keydown", e => {
        if (e.key === "Escape") definirMinimizado(!minimized);

        if (e.key === "Alt" && !e.repeat) {
            hidden = !hidden;
            gui.style.display = hidden ? "none" : "";
            toggle.style.display = hidden ? "none" : "";
            notifyBox.style.display = hidden ? "none" : "";
        }
    });

    document.addEventListener("mousedown", e => {
        if (e.button !== 1) return;

        e.preventDefault();
        hidden = !hidden;
        gui.style.display = hidden ? "none" : "";
        toggle.style.display = hidden ? "none" : "";
        notifyBox.style.display = hidden ? "none" : "";
    });

    notify("PORTUGA IA iniciada!");
})();