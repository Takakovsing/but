    "mousemove",
    function (event) {

        if (!toggleDragging) {
            return;
        }

        toggleMoved = true;

        toggle.style.left =
            event.clientX -
            toggleOffsetX +
            "px";

        toggle.style.top =
            event.clientY -
            toggleOffsetY +
            "px";

        toggle.style.right = "auto";
        toggle.style.bottom = "auto";
    }
);


document.addEventListener(
    "mouseup",
    function () {

        if (!toggleDragging) {
            return;
        }

        if (toggleMoved) {

            toggle.dataset.dragged =
                "true";
        }

        toggleDragging = false;
    }
);


