`;

document.body.appendChild(gui);


// ==============================
// BOTÃO FLUTUANTE
// ==============================

const toggle=document.createElement("div");

toggle.id="pgToggle";

toggle.innerHTML=`

<img src="https://media.tenor.com/m11vauEEbcUAAAAM/meow-neko-arc.gif">

`;

document.body.appendChild(toggle);


// ==============================
// NOTIFICAÇÃO
// ==============================

const notifyBox=document.createElement("div");

notifyBox.id="pgNotify";

notifyBox.textContent="Feito!!";

document.body.appendChild(notifyBox);


const $=id=>
document.getElementById(id);


// ==============================
// NOTIFY
// ==============================

function notify(text="Feito!!"){

    notifyBox.textContent=text;

    notifyBox.style.opacity="1";

    notifyBox.style.transform=
        "translateX(-50%) translateY(0)";

    setTimeout(()=>{

        notifyBox.style.opacity="0";

        notifyBox.style.transform=
            "translateX(-50%) translateY(-20px)";

    },1800);
}


// ==============================
// PEDIR API PRINCIPAL
// ==============================

function pedirApiPrincipal(){

    if(apiPrincipal)
        return true;

    const nova=
        prompt(
            "Cole sua chave principal do OpenRouter:"
        );

    if(!nova)
        return false;

    apiPrincipal=
        nova.trim();

    return true;
}


// ==============================
// API RESERVA
// SÓ APARECE QUANDO HOUVER
// ERRO DE LIMITE/COTA
// ==============================

function mostrarApiReserva(){

    $("pgReserveTitle").style.display=
        "block";

    $("pgReserve").style.display=
        "block";

    $("pgSaveReserve").style.display=
        "block";

    notify(
        "API principal atingiu o limite"
    );
}


// ==============================
// VERIFICA SE É LIMITE/COTA
// ==============================

function ehErroDeLimite(status,mensagem=""){

    const texto=
        String(mensagem).toLowerCase();

    return(
        status===429 ||

        texto.includes("rate limit") ||

        texto.includes("rate_limit") ||

        texto.includes("quota") ||

        texto.includes("credit limit") ||

        texto.includes("credits exhausted") ||

        texto.includes("insufficient credits") ||

        texto.includes("too many requests")
    );
}


// ==============================
// LER PÁGINA
// ==============================

$("pgRead").onclick=()=>{

    const clone=
        document.body.cloneNode(true);


    [
        "#pgFloat",
        "#pgToggle",
        "#pgNotify",
        "script",
        "style",
        "noscript"
    ].forEach(seletor=>{

        clone
        .querySelectorAll(seletor)
        .forEach(e=>e.remove());

    });


    pageText=
        clone.innerText
        .replace(/\n{3,}/g,"\n\n")
        .trim();


    pageText=
        pageText.slice(0,50000);


    // ==========================
    // IMAGENS
    // ==========================

    pageImages=[];


    const imagens=
        [...document.images];


    for(
        const img of imagens
    ){

        if(
            !img.src ||
            img.width<40 ||
            img.height<40
        ){

            continue;
        }


        if(
            img.closest("#pgFloat") ||
            img.closest("#pgToggle")
        ){

            continue;
        }


        const url=
            img.currentSrc ||
            img.src;


        if(
            !url ||
            url.startsWith("data:")
        ){

            continue;
        }


        if(
            !pageImages.includes(url)
        ){

            pageImages.push(url);
        }


        if(
            pageImages.length>=10
        ){

            break;
        }

    }


    if(
        !pageText &&
        !pageImages.length
    ){

        alert(
            "Não encontrei texto nem imagens!"
        );

        return;
    }


    $("pgStatus").textContent=
        "Texto: "+
        pageText.length+
        " caracteres | Imagens: "+
        pageImages.length;


    notify(
        "Página carregada!"
    );

};


// ==============================
// FAZER UMA REQUISIÇÃO
// ==============================

async function fazerPergunta(apiKey,pergunta){

    const content=[

        {
            type:"text",

            text:
                "PERGUNTA:\n"+
                pergunta+
                "\n\n"+
                "CONTEÚDO DA PÁGINA:\n"+
                pageText
        }

    ];


    for(
        const imagem of pageImages
    ){

        content.push({

            type:"image_url",

            image_url:{
                url:imagem
            }

        });

    }


    const resposta=
        await fetch(
            "https://openrouter.ai/api/v1/chat/completions",
            {

                method:"POST",

                headers:{

                    "Authorization":
                        "Bearer "+apiKey,

                    "Content-Type":
                        "application/json"

                },

                body:JSON.stringify({

                    model:
                        "openrouter/free",

                    messages:[

                        {

                            role:"system",

                            content:
                                "Responda em português de forma clara e objetiva. Analise o texto e as imagens fornecidas quando forem relevantes. Não inclua classificações internas de segurança na resposta."
                        },

                        {

                            role:"user",

                            content:content

                        }

                    ]

                })

            }
        );


    const dados=
        await resposta.json();


    return{
        resposta,
        dados
    };

}


// ==============================
// SAFETY
// ==============================

function respostaEhSafety(texto){

    if(!texto)
        return true;

    const t=
        String(texto)
        .trim()
        .toLowerCase();


    return(
        t==="user safety: safe" ||

        t.startsWith(
            "user safety: safe"
        )
    );
}


// ==============================
// PERGUNTAR À IA
// ==============================

$("pgAsk").onclick=async()=>{

    const pergunta=
        $("pgQuestion")
        .value
        .trim();


    if(!pergunta){

        alert(
            "Digite uma pergunta primeiro!"
        );

        return;
    }


    if(
        !pageText &&
        !pageImages.length
    ){

        alert(
            "Clique em LER PÁGINA + IMAGENS primeiro!"
        );

        return;
    }


    if(
        !usandoReserva &&
        !pedirApiPrincipal()
    ){

        return;
    }


    const apiAtual=
        usandoReserva
        ? apiReserva
        : apiPrincipal;


    if(!apiAtual){

        alert(
            "Nenhuma API disponível."
        );

        return;
    }


    $("pgAsk").textContent=
        "CONSULTANDO IA...";

    $("pgAsk").disabled=true;

    $("pgAnswer").value=
        "Analisando...";


    try{

        let resultado="";

        let ultimaMensagem="";

        let limiteDetectado=false;


        // ======================
        // TENTATIVAS
        // ======================

        for(
            let tentativa=1;
            tentativa<=MAX_TENTATIVAS_SAFETY;
            tentativa++
        ){

            $("pgAnswer").value=
                "Consultando IA..."+
                "\nTentativa "+
                tentativa+
                "/"+
                MAX_TENTATIVAS_SAFETY;


            const retorno=
                await fazerPergunta(
                    apiAtual,
                    pergunta
                );


            const status=
                retorno.resposta.status;


            const dados=
                retorno.dados;


            const mensagemErro=
                dados?.error?.message ||
                "";


            ultimaMensagem=
                mensagemErro;


            // ==================
            // LIMITE/COTA
            // ==================

            if(
                ehErroDeLimite(
                    status,
                    mensagemErro
                )
            ){

                limiteDetectado=true;

                break;
            }


            // ==================
            // OUTRO ERRO
            // ==================

            if(
                !retorno.resposta.ok
            ){

                throw new Error(
                    mensagemErro ||
                    "Erro HTTP "+
                    status
                );

            }


            resultado=
                dados
                ?.choices
                ?.[0]
                ?.message
                ?.content;


            if(
                typeof resultado!=="string"
            ){

                resultado=
                    JSON.stringify(
                        resultado,
                        null,
                        2
                    );

            }


            // ==================
            // SAFETY
            // ==================

            if(
                respostaEhSafety(
                    resultado
                )
            ){

                if(
                    tentativa<
                    MAX_TENTATIVAS_SAFETY
                ){

                    await new Promise(
                        resolve=>
                            setTimeout(
                                resolve,
                                700
                            )
                    );

                    continue;

                }


                // Terminou as tentativas
                // de safety.

                resultado=
                    "";

                break;

            }


            // ==================
            // RESPOSTA NORMAL
            // ==================

            if(resultado){

                break;
            }

        }


        // ======================
        // LIMITE DA API
        // ======================

        if(limiteDetectado){

            if(!usandoReserva){

                mostrarApiReserva();

                $("pgAnswer").value=
                    "A API principal atingiu o limite.\n\n"+
                    "Cole uma API reserva abaixo.";

                return;

            }else{

                throw new Error(
                    "A API reserva também atingiu o limite."
                );

            }

        }


        // ======================
        // SAFETY ESGOTADO
        // ======================

        if(!resultado){

            $("pgAnswer").value=
                "A IA não retornou uma resposta válida após "+
                MAX_TENTATIVAS_SAFETY+
                " tentativas.";

            notify(
                "Tentativas esgotadas"
            );

            return;

        }


        // ======================
        // LIMPEZA
        // ======================

        resultado=
            resultado
            .replace(
                /^User Safety:\s*(safe|unsafe)\s*$/gim,
                ""
            )
            .trim();


        $("pgAnswer").value=
            resultado;


        notify(
            usandoReserva
            ? "Resposta pela API reserva!"
            : "Resposta recebida!"
        );


    }catch(erro){

        $("pgAnswer").value=
            "ERRO:\n\n"+
            erro.message;


        alert(
            "Erro ao consultar a IA:\n\n"+
            erro.message
        );


    }finally{

        $("pgAsk").textContent=
            "PERGUNTAR À IA";

        $("pgAsk").disabled=false;

    }

};


// ==============================
// SALVAR API RESERVA
// ==============================

$("pgSaveReserve").onclick=()=>{

    const nova=
        $("pgReserve")
        .value
        .trim();


    if(!nova){

        alert(
            "Cole uma API reserva primeiro!"
        );

        return;
    }


    apiReserva=
        nova;

    usandoReserva=true;


    $("pgStatus").textContent=
        "API reserva ativada";


    notify(
        "API reserva ativada!"
    );

};


// ==============================
// MINIMIZAR
// ==============================

toggle.onclick=()=>{

    if(
        toggle.dataset.dragged===
        "true"
    ){

        toggle.dataset.dragged=
        "false";

        return;
    }


    minimized=!minimized;


    gui.classList.toggle(
        "pgMini",
        minimized
    );

};


// ==============================
// ARRASTAR BOTÃO PC
// ==============================

let toggleDragging=false;
let toggleMoved=false;

let toggleOffsetX=0;
let toggleOffsetY=0;


toggle.addEventListener(
    "mousedown",
    event=>{

        toggleDragging=true;

        toggleMoved=false;

        toggleOffsetX=
            event.clientX-
            toggle.offsetLeft;

        toggleOffsetY=
            event.clientY-
            toggle.offsetTop;

        event.preventDefault();

    }
);


document.addEventListener(
    "mousemove",
    event=>{

        if(!toggleDragging)
            return;


        toggleMoved=true;


        toggle.style.left=
            event.clientX-
            toggleOffsetX+
            "px";


        toggle.style.top=
            event.clientY-
            toggleOffsetY+
            "px";


        toggle.style.right="auto";

        toggle.style.bottom="auto";

    }
);


document.addEventListener(
    "mouseup",
    ()=>{

        if(!toggleDragging)
            return;


        if(toggleMoved){

            toggle.dataset.dragged=
            "true";

        }


        toggleDragging=false;

    }
);


// ==============================
// ARRASTAR BOTÃO CELULAR
// ==============================

toggle.addEventListener(
    "touchstart",
    event=>{

        const touch=
            event.touches[0]
