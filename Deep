    // ==============================
    // BYPASS ANTI-COLA
    // ==============================

    function applyBypass() {
        // Remove bloqueios de eventos
        document.addEventListener('copy', function(e) {
            e.stopPropagation();
        }, true);

        document.addEventListener('selectstart', function(e) {
            e.stopPropagation();
        }, true);

        document.addEventListener('contextmenu', function(e) {
            e.stopPropagation();
        }, true);

        // Força seleção em todos os elementos
        const style = document.createElement("style");
        style.id = "pgBypassStyle";
        style.innerHTML = `
            * {
                -webkit-user-select: text !important;
                user-select: text !important;
                -webkit-touch-callout: default !important;
            }
            input, textarea, [contenteditable] {
                -webkit-user-select: text !important;
                user-select: text !important;
            }
        `;
        document.head.appendChild(style);

        // Sobrescreve execCommand
        const originalExec = document.execCommand;
        document.execCommand = function(command, ...args) {
            if (command === 'copy' || command === 'cut') {
                return true;
            }
            return originalExec.call(this, command, ...args);
        };

        // Protege clipboard
        Object.defineProperty(navigator, 'clipboard', {
            value: navigator.clipboard,
            writable: false,
            configurable: false
        });

        // Força seleção em todos elementos existentes
        document.querySelectorAll('*').forEach(el => {
            el.style.userSelect = 'text';
            el.style.webkitUserSelect = 'text';
            el.setAttribute('unselectable', 'off');
        });
    }

    // ==============================
    // MONITORAMENTO
    // ==============================

    let monitorInterval = null;
    let logs = [];

    function startMonitoring() {
        if (monitorInterval) return;
        
        logs = [];
        addLog("🚀 Monitor iniciado");

        monitorInterval = setInterval(() => {
            // Verifica se ainda está ativo
            const style = document.getElementById("pgBypassStyle");
            if (!style) {
                addLog("⚠️ CSS removido, reaplicando...");
                applyBypass();
            }

            // Verifica elementos com bloqueio
            const blocked = document.querySelectorAll('[style*="user-select: none"], [style*="user-select:none"]');
            if (blocked.length > 0) {
                addLog(`🛡️ Removendo bloqueio de ${blocked.length} elementos`);
                blocked.forEach(el => {
                    el.style.userSelect = 'text';
                    el.style.webkitUserSelect = 'text';
                    el.setAttribute('unselectable', 'off');
                });
            }

            // Verifica eventos
            const hasCopyBlocker = document.querySelector('[oncopy], [oncut], [onpaste]');
            if (hasCopyBlocker) {
                addLog("🔓 Removendo bloqueadores de eventos");
                document.querySelectorAll('[oncopy], [oncut], [onpaste]').forEach(el => {
                    el.removeAttribute('oncopy');
                    el.removeAttribute('oncut');
                    el.removeAttribute('onpaste');
                });
            }

        }, 1000);
    }

    function stopMonitoring() {
        if (monitorInterval) {
            clearInterval(monitorInterval);
            monitorInterval = null;
            addLog("⏹️ Monitor pausado");
        }
    }

    function addLog(message) {
        const timestamp = new Date().toLocaleTimeString();
        logs.unshift(`[${timestamp}] ${message}`);
        if (logs.length > 50) logs.pop();
        updateLogDisplay();
    }

