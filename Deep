    });

    // ==============================
    // ESCONDER / MOSTRAR
    // ==============================

    function toggleHiddenMode() {
        altHidden = !altHidden;
        if (altHidden) {
            if (typing) typingPaused = true;
            gui.style.display = "none";
            toggle.style.display = "none";
            notifyBox.style.display = "none";
            document.body.style.filter = "none";
        } else {
            gui.style.display = "";
            toggle.style.display = "";
            notifyBox.style.display = "";
            document.body.style.filter = "invert(1) hue-rotate(180deg)";
            if (typing) typingPaused = false;
        }
    }

    // ==============================
    // ATALHOS
    // ==============================

    document.addEventListener("keydown", function (event) {
        if (event.key === "Escape") {
            minimized = !minimized;
            gui.classList.toggle("pgMini", minimized);
            return;
        }

        if (event.key === "Control") {
            if (typing) {
                typingPaused = !typingPaused;
                notify(typingPaused ? "Digitação pausada" : "Digitação continuando");
            }
            return;
        }

        if (event.key === "Alt") {
            toggleHiddenMode();
            return;
        }
    });

    // ==============================
    // CLIQUE NO SCROLL
    // ==============================

    document.addEventListener("mousedown", function (event) {
        if (event.button !== 1) return;
        event.preventDefault();
        toggleHiddenMode();
    });

    // ==============================
    // BYPASS ADICIONAL - MONITORA BLOQUEIOS
    // ==============================

    // Observer para detectar e remover bloqueios adicionais
    const observer = new MutationObserver(function(mutations) {
        mutations.forEach(function(mutation) {
            if (mutation.type === 'attributes' && 
                (mutation.attributeName === 'style' || 
                 mutation.attributeName === 'class')) {
                const el = mutation.target;
                if (el.style) {
                    el.style.userSelect = 'text';
                    el.style.webkitUserSelect = 'text';
                }
            }
        });
    });

    // Observa mudanças em toda a página
    observer.observe(document.body, {
        attributes: true,
        attributeFilter: ['style', 'class'],
        subtree: true,
        childList: true
    });

    // Força seleção em toda página periodicamente
    setInterval(function() {
        document.querySelectorAll('*').forEach(el => {
            if (el.style) {
                el.style.userSelect = 'text';
                el.style.webkitUserSelect = 'text';
            }
            el.setAttribute('unselectable', 'off');
        });
    }, 5000);

