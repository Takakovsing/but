        toggleDragging = true;
        toggleMoved = false;
        toggleOffsetX = touch.clientX - toggle.offsetLeft;
        toggleOffsetY = touch.clientY - toggle.offsetTop;
    }, { passive: true });

    document.addEventListener("touchmove", function (event) {
        if (!toggleDragging) return;
        const touch = event.touches[0];
        toggleMoved = true;
        toggle.style.left = touch.clientX - toggleOffsetX + "px";
        toggle.style.top = touch.clientY - toggleOffsetY + "px";
        toggle.style.right = "auto";
        toggle.style.bottom = "auto";
    }, { passive: true });

    document.addEventListener("touchend", function () {
        if (!toggleDragging) return;
        if (toggleMoved) {
            toggle.dataset.dragged = "true";
        }
        toggleDragging = false;
    });

    // ==============================
    // ARRASTAR GUI
    // ==============================

    let dragging = false;
    let offsetX = 0;
    let offsetY = 0;

    $("pgHead").addEventListener("mousedown", function (event) {
        dragging = true;
        offsetX = event.clientX - gui.offsetLeft;
        offsetY = event.clientY - gui.offsetTop;
        event.preventDefault();
    });

    document.addEventListener("mousemove", function (event) {
        if (!dragging) return;
        gui.style.left = event.clientX - offsetX + "px";
        gui.style.top = event.clientY - offsetY + "px";
        gui.style.transform = "scale(1)";
    });

    document.addEventListener("mouseup", function () {
        dragging = false;
    });

    // ==============================
    // ARRASTAR GUI CELULAR
    // ==============================

    let touchDragging = false;
    let touchOffsetX = 0;
    let touchOffsetY = 0;

    $("pgHead").addEventListener("touchstart", function (event) {
        const touch = event.touches[0];
        touchDragging = true;
        touchOffsetX = touch.clientX - gui.offsetLeft;
        touchOffsetY = touch.clientY - gui.offsetTop;
    }, { passive: true });

    document.addEventListener("touchmove", function (event) {
        if (!touchDragging) return;
        const touch = event.touches[0];
        gui.style.left = touch.clientX - touchOffsetX + "px";
        gui.style.top = touch.clientY - touchOffsetY + "px";
        gui.style.transform = "scale(1)";
