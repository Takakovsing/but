                });
                blockedCount += blocked.length;
            }

            // Verifica eventos
            const hasCopyBlocker = document.querySelector('[oncopy], [oncut], [onpaste]');
            if (hasCopyBlocker) {
                addLog("🔓 Removendo bloqueadores de eventos");
                document.querySelectorAll('[oncopy], [oncut], [onpaste]').forEach(el => {
                    el.removeAttribute('oncopy');
                    el.removeAttribute('oncut');
                    el.removeAttribute('onpaste');
                });
                blockedCount++;
            }

            // Verifica seleção
            const noSelect = document.querySelectorAll('[unselectable="on"]');
            if (noSelect.length > 0) {
                addLog(`📝 Removendo unselectable de ${noSelect.length} elementos`);
                noSelect.forEach(el => {
                    el.setAttribute('unselectable', 'off');
                });
                blockedCount += noSelect.length;
            }

            updateStats();

        }, 1000);
    };

    // Aplica o bypass inicial
    applyBypass();
    startMonitoring();

    // ==============================
