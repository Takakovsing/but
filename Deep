document.addEventListener(
    "keydown",
    function (event) {

        if (event.key === "Escape") {

            minimized = !minimized;

            gui.classList.toggle(
                "pgMini",
                minimized
            );

            return;
        }


        if (event.key === "Control") {

            if (typing) {

                typingPaused =
                    !typingPaused;

                if (typingPaused) {

                    notifyBox.textContent =
                        "Digitação pausada";

                } else {

                    notifyBox.textContent =
                        "Digitação continuando";
                }

                if (!altHidden) {
                    notify();
                }
            }

            return;
        }


        if (event.key === "Alt") {

            toggleHiddenMode();

            return;
        }
    }
);


