async function iniciarDigitacao(text) {

    if (!text) {

        alert(
            "Nenhum texto foi informado!"
        );

        return;
    }

    const fields =
        document.querySelectorAll(
            "textarea:not(#pgText), input"
        );

    if (!fields.length) {

        alert(
            "Nenhuma caixa de texto foi encontrada!"
        );

        return;
    }

    const field = fields[0];

    typing = true;
    typingPaused = false;

    field.focus();

    for (const char of text) {

        while (
            typingPaused &&
            typing
        ) {

            await new Promise(
                function (resolve) {
                    setTimeout(resolve, 50);
                }
            );
        }

        if (!typing) {
            return;
        }

        field.setRangeText(
            char,
            field.selectionStart,
            field.selectionEnd,
            "end"
        );

        field.dispatchEvent(
            new InputEvent(
                "input",
                {
                    bubbles: true,
                    data: char,
                    inputType: "insertText"
                }
            )
        );

        await new Promise(
            function (resolve) {
                setTimeout(resolve, 20);
            }
        );
    }

    typing = false;

    if (!altHidden) {
        notify();
    }
}


