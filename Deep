
(async () => {
    "use strict";

    const KEY_CORRETA = "rzinmodder";

    if (prompt("Digite a Key:") !== KEY_CORRETA) {
        alert("Key inválida!");
        return;
    }

    if (document.getElementById("pgFloat")) return;

    let apiKey = "";
    let nivel = "medio";
    let busy = false;
    let minimized = false;
    let notifyTimer;

    const $ = id => document.getElementById(id);

    const niveis = ["baixo", "medio", "alto"];

    const nomesNivel = {
        baixo: "BAIXO",
        medio: "MÉDIO",
        alto: "ALTO"
    };

    const descNivel = {
        baixo: "Use linguagem simples, frases curtas e vocabulário básico.",
        medio: "Use vocabulário intermediário, boa coesão e argumentação equilibrada.",
        alto: "Use argumentação aprofundada, repertório sociocultural, conectivos variados e excelente coesão."
    };

    const style = document.createElement("style");

    style.textContent = `
        #pgFloat, #pgToggle, #pgNotify { box-sizing: border-box; }

        #pgFloat {
            position: fixed;
            top: 80px;
            left: 50%;
            width: min(340px, calc(100vw - 24px));
            padding: 17px;
            color: #f5f5f5;
            font: 14px "Trebuchet MS", Arial, sans-serif;
            background: linear-gradient(145deg,rgba(30,30,34,.95),rgba(8,8,10,.9));
            border: 1px solid #ffffff35;
            border-radius: 20px;
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            box-shadow: 0 18px 55px #000b, 0 0 20px #fff1;
            z-index: 2147483640;
            transform: translateX(-50%);
            overflow: hidden;
            user-select: none;
        }

        #pgFloat:before {
            content: "";
            position: absolute;
            inset: -100%;
            background: conic-gradient(
                transparent, #ffffff20, transparent, #ffffff10, transparent
            );
            animation: pgGlow 8s linear infinite;
            pointer-events: none;
        }

        @keyframes pgGlow {
            to { transform: rotate(360deg); }
        }

        #pgFloat > * { position: relative; }

        #pgFloat.pgMini {
            opacity: 0;
            visibility: hidden;
            transform: translateX(-50%) scale(.82);
            pointer-events: none;
        }

        #pgHead {
            height: 36px;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 18px;
            font-weight: 900;
            letter-spacing: 2px;
            cursor: move;
            touch-action: none;
        }

        #pgStatus {
            color: #aaa;
            font-size: 10px;
            text-align: center;
            letter-spacing: 1px;
            margin: 3px 0 14px;
        }

        #pgLine {
            height: 1px;
            margin-bottom: 13px;
            background: linear-gradient(90deg,transparent,#fff8,transparent);
        }

        #pgFloat button {
            width: 100%;
            padding: 12px;
            margin-top: 9px;
            color: #eee;
            background: #ffffff13;
            border: 1px solid #ffffff25;
            border-radius: 11px;
            font: bold 13px "Trebuchet MS",Arial,sans-serif;
            cursor: pointer;
            transition: .2s;
        }

        #pgFloat button:hover {
            background: #ffffff28;
            border-color: #ffffff66;
        }

        #pgFloat button:disabled {
            opacity: .6;
            cursor: wait;
        }

        #pgGerar {
            color: #111 !important;
            background: linear-gradient(110deg,#fff,#ccc) !important;
            border-color: #fff !important;
        }

        #pgFoot {
            margin-top: 13px;
            color: #999;
            font-size: 10px;
            text-align: center;
            letter-spacing: 1px;
        }

        #pgToggle {
            position: fixed;
            right: 20px;
            bottom: 25px;
            width: 62px;
            height: 62px;
            border: 2px solid #aaa;
            border-radius: 50%;
            background: #111;
            box-shadow: 0 0 15px #fff3,0 8px 30px #000b;
            z-index: 2147483641;
            cursor: pointer;
            overflow: hidden;
            touch-action: none;
        }

        #pgToggle img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            pointer-events: none;
        }

        #pgNotify {
            position: fixed;
            top: 22px;
            left: 50%;
            transform: translate(-50%,-15px);
            padding: 12px 20px;
            color: #fff;
            background: rgba(15,15,18,.96);
            border: 1px solid #ffffff38;
            border-radius: 12px;
            font: bold 13px Arial,sans-serif;
            box-shadow: 0 8px 30px #0008;
            z-index: 2147483642;
            opacity: 0;
            transition: opacity .25s,transform .25s;
            pointer-events: none;
            max-width: 85vw;
            overflow-wrap: anywhere;
        }
    `;

    document.head.appendChild(style);

    const gui = document.createElement("div");
    gui.id = "pgFloat";
    gui.innerHTML = `
        <div id="pgHead">✦ PORTUGA IA ✦</div>
        <div id="pgStatus">INTELIGÊNCIA ARTIFICIAL</div>
        <div id="pgLine"></div>
        <button id="pgNivel">NÍVEL: MÉDIO</button>
        <button id="pgGerar">✧ GERAR REDAÇÃO</button>
        <div id="pgFoot">PREMIUM INTERFACE</div>
    `;
    document.body.appendChild(gui);

    const toggle = document.createElement("div");
    toggle.id = "pgToggle";
    toggle.innerHTML = `
        <img alt="PORTUGA IA"
        src="https://media.tenor.com/m11vauEEbcUAAAAM/meow-neko-arc.gif">
    `;
    document.body.appendChild(toggle);

    const notifyBox = document.createElement("div");
    notifyBox.id = "pgNotify";
    document.body.appendChild(notifyBox);

    function notify(msg, persist = false) {
        notifyBox.textContent = msg;
        notifyBox.style.opacity = "1";
        notifyBox.style.transform = "translate(-50%,0)";

        clearTimeout(notifyTimer);

        if (!persist) {
            notifyTimer = setTimeout(() => {
                notifyBox.style.opacity = "0";
                notifyBox.style.transform = "translate(-50%,-15px)";
            }, 2500);
        }
    }

    $("pgNivel").onclick = () => {
        nivel = niveis[(niveis.indexOf(nivel) + 1) % niveis.length];
        $("pgNivel").textContent = "NÍVEL: " + nomesNivel[nivel];
        notify("Nível: " + nomesNivel[nivel]);
    };

    function lerPagina() {
        const clone = document.body.cloneNode(true);

        ["#pgFloat", "#pgToggle", "#pgNotify",
         "script", "style", "noscript"].forEach(selector => {
            clone.querySelectorAll(selector).forEach(el => el.remove());
        });

        return (clone.innerText || "")
            .replace(/\n{3,}/g, "\n\n")
            .trim()
            .slice(0, 30000);
    }

    function acharCampo() {
        const seletores = [
            'textarea[name*="redac" i]',
            'textarea[id*="redac" i]',
            'textarea[placeholder*="redac" i]',
            'textarea[placeholder*="escreva" i]',
            'textarea[placeholder*="digite" i]',
            'textarea[placeholder*="resposta" i]'
        ];

        for (const selector of seletores) {
            try {
                const el = document.querySelector(selector);
                if (el && el.getClientRects().length &&
                    !el.disabled && !el.readOnly) return el;
            } catch (_) {}
        }

        const areas = [...document.querySelectorAll("textarea")]
            .filter(el => el.getClientRects().length &&
                !el.disabled && !el.readOnly);

        if (areas.length) {
            return areas.sort((a,b) =>
                b.clientWidth*b.clientHeight -
                a.clientWidth*a.clientHeight
            )[0];
        }

        return [...document.querySelectorAll('[contenteditable="true"]')]
            .find(el => el.getClientRects().length) || null;
    }

    function aplicarTexto(campo, texto) {
        campo.focus();

        if (campo instanceof HTMLTextAreaElement ||
            campo instanceof HTMLInputElement) {
            const proto = campo instanceof HTMLTextAreaElement
                ? HTMLTextAreaElement.prototype
                : HTMLInputElement.prototype;

            const setter = Object.getOwnPropertyDescriptor(proto, "value").set;
            setter.call(campo, texto);
            campo.dispatchEvent(new Event("input", { bubbles: true }));
            campo.dispatchEvent(new Event("change", { bubbles: true }));
        } else {
            campo.replaceChildren();

            texto.split(/\n{2,}/).forEach(paragrafo => {
                const p = document.createElement("p");
                p.textContent = paragrafo;
                campo.appendChild(p);
            });

            campo.dispatchEvent(new InputEvent("input", {
                bubbles: true,
                inputType: "insertText",
                data: texto
            }));
        }
    }

    async function gerarRedacao(chave, pageText) {
        const response = await fetch(
            "https://openrouter.ai/api/v1/chat/completions",
            {
                method: "POST",
                headers: {
                    "Authorization": "Bearer " + chave,
                    "Content-Type": "application/json",
                    "X-OpenRouter-Title": "PORTUGA IA"
                },
                body: JSON.stringify({
                    model: "openrouter/auto",
                    messages: [
                        {
                            role: "system",
                            content:
                                "Você é especialista em redações escolares em português. " +
                                "Identifique o tema do material e escreva uma redação original, " +
                                "coerente e adequada ao nível solicitado. " +
                                descNivel[nivel] +
                                " Responda apenas com a redação, sem comentários adicionais. " +
                                "Separe os parágrafos com uma linha em branco."
                        },
                        {
                            role: "user",
                            content:
                                "Material da atividade:\n\n" + pageText
                        }
                    ],
                    temperature: 0.7,
                    max_tokens: 2500
                })
            }
        );

        let dados;

        try {
            dados = await response.json();
        } catch (_) {
            throw new Error("A API retornou uma resposta inválida.");
        }

        if (!response.ok || dados.error) {
            console.error("Erro OpenRouter:", dados);

            const erro = dados?.error || {};
            const mensagem = String(
                erro.message ||
                dados?.message ||
                "Erro HTTP " + response.status
            );

            if (response.status === 401 || response.status === 403) {
                apiKey = "";
            }

            if (response.status === 429) {
                throw new Error(
                    "Limite de requisições atingido. Aguarde e tente novamente. " +
                    mensagem
                );
            }

            if (/user safety|safety|moderation|content.filter/i.test(mensagem)) {
                throw new Error(
                    "O provedor ou modelo recusou a solicitação por uma regra " +
                    "de segurança. Detalhe original: " + mensagem
                );
            }

            throw new Error(mensagem);
        }

        let texto = dados?.choices?.[0]?.message?.content;

        if (Array.isArray(texto)) {
            texto = texto.map(item =>
                typeof item === "string" ? item : item?.text || ""
            ).join("\n");
        }

        if (typeof texto !== "string" || !texto.trim()) {
            throw new Error("O modelo não retornou uma redação.");
        }

        return texto
            .replace(/^```[\w-]*\s*/, "")
            .replace(/\s*```$/, "")
            .trim();
    }

    $("pgGerar").onclick = async () => {
        if (busy) return;

        if (!apiKey) {
            const entrada = prompt("Cole sua chave da API OpenRouter:");
            if (!entrada) return;
            apiKey = entrada.trim();
        }

        const campo = acharCampo();

        if (!campo) {
            alert("Não encontrei um campo de texto editável nesta página.");
            return;
        }

        const pageText = lerPagina();

        if (!pageText) {
            alert("Não consegui ler o conteúdo da página.");
            return;
        }

        busy = true;
        const btn = $("pgGerar");
        btn.disabled = true;
        btn.textContent = "GERANDO...";
        notify("Solicitando redação à IA...", true);

        try {
            const texto = await gerarRedacao(apiKey, pageText);

            btn.textContent = "PREENCHENDO...";
            aplicarTexto(campo, texto);

            notify("Redação preenchida!");
        } catch (erro) {
            console.error("[PORTUGA IA]", erro);
            notify("Erro ao gerar redação.");

            alert(
                "Erro ao gerar redação:\n\n" +
                (erro?.message || "Erro desconhecido") +
                "\n\nConsulte o console para obter detalhes."
            );
        } finally {
            busy = false;
            btn.disabled = false;
            btn.textContent = "✧ GERAR REDAÇÃO";
        }
    };

    toggle.onclick = () => {
        minimized = !minimized;
        gui.classList.toggle("pgMini", minimized);
    };

    // Arrastar a interface no computador e no celular
    function iniciarArraste(e) {
        dragging = true;

        const ponto = e.touches ? e.touches[0] : e;
        offsetX = ponto.clientX - gui.offsetLeft;
        offsetY = ponto.clientY - gui.offsetTop;
    }

    function moverArraste(e) {
        if (!dragging) return;

        const ponto = e.touches ? e.touches[0] : e;
        if (!ponto) return;

        gui.style.left = (ponto.clientX - offsetX) + "px";
        gui.style.top = (ponto.clientY - offsetY) + "px";
        gui.style.transform = "none";
    }

    function pararArraste() {
        dragging = false;
    }

    $("pgHead").addEventListener("mousedown", iniciarArraste);
    document.addEventListener("mousemove", moverArraste);
    document.addEventListener("mouseup", pararArraste);

    $("pgHead").addEventListener("touchstart", iniciarArraste, {
        passive: true
    });

    document.addEventListener("touchmove", moverArraste, {
        passive: true
    });

    document.addEventListener("touchend", pararArraste);

    document.addEventListener("keydown", e => {
        if (e.key === "Escape") {
            minimized = !minimized;
            gui.classList.toggle("pgMini", minimized);
        }

        if (e.key === "Alt" && !e.repeat) {
            hidden = !hidden;
            gui.style.display = hidden ? "none" : "";
            toggle.style.display = hidden ? "none" : "";
            notifyBox.style.display = hidden ? "none" : "";
        }
    });

    document.addEventListener("mousedown", e => {
        if (e.button === 1) {
            e.preventDefault();

            hidden = !hidden;
            gui.style.display = hidden ? "none" : "";
            toggle.style.display = hidden ? "none" : "";
            notifyBox.style.display = hidden ? "none" : "";
        }
    });

    notify("PORTUGA IA iniciado!");
})();
