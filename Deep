    ✍️ GERAR REDAÇÃO
</button>

`;

document.body.appendChild(gui);


// ==============================
// BOTÃO
// ==============================

const toggle=document.createElement("div");

toggle.id="pgToggle";

toggle.innerHTML=`

<img src="https://media.tenor.com/m11vauEEbcUAAAAM/meow-neko-arc.gif">

`;

document.body.appendChild(toggle);


// ==============================
// NOTIFICAÇÃO
// ==============================

const notifyBox=document.createElement("div");

notifyBox.id="pgNotify";

notifyBox.textContent="Feito!!";

document.body.appendChild(notifyBox);

const $=id=>
document.getElementById(id);


// ==============================
// NOTIFY
// ==============================

let notifyTimer=null;

function notify(text="Feito!!",persist=false){

    notifyBox.textContent=text;

    notifyBox.style.opacity="1";

    notifyBox.style.transform=
        "translateX(-50%) translateY(0)";

    clearTimeout(notifyTimer);

    if(persist)return;

    notifyTimer=setTimeout(()=>{

        notifyBox.style.opacity="0";

        notifyBox.style.transform=
            "translateX(-50%) translateY(-20px)";

    },1800);

}


// ==============================
// NÍVEIS
// ==============================

const niveis=["baixo","medio","alto"];

const nomesNivel={
    baixo:"BAIXO",
    medio:"MÉDIO",
    alto:"ALTO"
};

const descNivel={

    baixo:
        "Linguagem simples, frases curtas, vocabulário básico, estrutura direta e objetiva.",

    medio:
        "Vocabulário intermediário, algumas figuras de linguagem, boa coesão e argumentação equilibrada.",

    alto:
        "Vocabulário rebuscado, argumentação sofisticada, repertório sociocultural, conectivos variados e alta coesão."

};


$("pgNivel").onclick=()=>{

    const i=niveis.indexOf(nivel);

    nivel=niveis[(i+1)%niveis.length];

    $("pgNivel").textContent=
        "🎚️ NÍVEL: "+
        nomesNivel[nivel];

    notify("Nível: "+nomesNivel[nivel]);

};


// ==============================
// LER PÁGINA
// ==============================

function lerPagina(){

    const clone=
        document.body.cloneNode(true);

    [
        "#pgFloat",
        "#pgToggle",
        "#pgNotify",
        "script",
        "style",
        "noscript"
    ].forEach(seletor=>{

        clone
        .querySelectorAll(seletor)
        .forEach(e=>e.remove());

    });

    return clone.innerText
        .replace(/\n{3,}/g,"\n\n")
        .trim()
        .slice(0,50000);

}


// ==============================
// ACHAR CAMPO DE TEXTO
// ==============================

function acharCampo(){

    // 1) tenta seletores comuns de campo de redação
    const preferidos=[

        'textarea[name*="redac" i]',
        'textarea[id*="redac" i]',
        'textarea[class*="redac" i]',
        'textarea[placeholder*="redac" i]',
        'textarea[placeholder*="digite" i]',
        'textarea[placeholder*="escreva" i]',
        'textarea[placeholder*="texto" i]',
        'textarea[aria-label*="redac" i]',
        'textarea[aria-label*="resposta" i]'

    ];

    for(const sel of preferidos){

        let el;

        try{
            el=document.querySelector(sel);
        }catch(e){
            continue;
        }

        if(el && el.offsetParent!==null){

            return el;
        }
    }

    // 2) fallback: maior textarea visível
    const areas=
        [...document.querySelectorAll("textarea")]
        .filter(e=>e.offsetParent!==null);

    if(areas.length){

        return areas.sort((a,b)=>
            (b.clientHeight*b.clientWidth)-
            (a.clientHeight*a.clientWidth)
        )[0];

    }

    // 3) fallback: contenteditable visível
    const edit=
        [...document.querySelectorAll(
            '[contenteditable="true"]'
        )].filter(e=>e.offsetParent!==null);

    return edit[0]||null;

}


// ==============================
// DESTAQUE DO CAMPO ESCOLHIDO
// ==============================

function destacarCampo(campo){

    const antigo=campo.style.outline;

    campo.style.outline=
        "3px solid lime";

    setTimeout(()=>{

        campo.style.outline=antigo;

    },1500);

}


// ==============================
// SETTER NATIVO (React / Vue)
// ==============================

function setNative(el,val){

    const proto=
        el.tagName==="TEXTAREA"
        ? HTMLTextAreaElement.prototype
        : HTMLInputElement.prototype;

    const setter=
        Object.getOwnPropertyDescriptor(
            proto,
            "value"
        ).set;

    setter.call(el,val);

    el.dispatchEvent(
        new Event("input",{bubbles:true})
    );

}


// ==============================
// DIGITAR
// ==============================

async function digitar(campo,texto){

    campo.focus();

    if(
        campo.tagName==="TEXTAREA" ||
        campo.tagName==="INPUT"
    ){

        setNative(campo,"");

        let acumulado="";

        for(let i=0;i<texto.length;i++){

            acumulado+=texto[i];

            setNative(campo,acumulado);

            if(i%20===0){

                await new Promise(
                    r=>setTimeout(r,12)
                );
            }
        }

        campo.dispatchEvent(
            new Event(
                "change",
                {bubbles:true}
            )
        );

    }else{

        // contenteditable

        campo.innerHTML="";

        campo.dispatchEvent(
            new InputEvent(
                "input",
                {bubbles:true}
            )
        );

        for(let i=0;i<texto.length;i++){

            document.execCommand(
                "insertText",
                false,
                texto[i]
            );

            if(i%20===0){

                await new Promise(
                    r=>setTimeout(r,12)
                );
            }
        }
    }
}


// ==============================
// GERAR REDAÇÃO
// ==============================

$("pgGerar").onclick=async()=>{

    if(!apiKey){

        apiKey=
            prompt(
                "Cole sua chave do OpenRouter:"
            );

        if(!apiKey){

            return;
        }
    }

    const campo=acharCampo();

    if(!campo){

        alert(
            "Não encontrei nenhum campo de texto na página!"
        );

        return;
    }

    destacarCampo(campo);

    $("pgGerar").disabled=true;

    $("pgGerar").textContent=
        "📖 LENDO PÁGINA...";

    notify("Lendo página...",true);


    const pageText=lerPagina();

    if(!pageText){

        alert(
            "Não consegui ler o conteúdo da página!"
        );

        $("pgGerar").disabled=false;

        $("pgGerar").textContent=
            "✍️ GERAR REDAÇÃO";

        return;
    }


    $("pgGerar").textContent=
        "🤖 GERANDO...";

    notify(
        "Gerando redação ("+
        nomesNivel[nivel]+
        ")...",
        true
    );


    try{

        const resposta=
            await fetch(
                "https://openrouter.ai/api/v1/chat/completions",
                {

                    method:"POST",

                    headers:{

                        "Authorization":
                            "Bearer "+apiKey,

                        "Content-Type":
                            "application/json"

                    },

                    body:JSON.stringify({

                        model:
                            "openrouter/free",

                        messages:[

                            {

                                role:"system",

                                content:
                                    "Você é um especialista em redações. "+
                                    "PRIMEIRO identifique o TEMA da redação a partir do conteúdo da página. "+
                                    "DEPOIS escreva uma redação completa em português sobre esse tema. "+
                                    "NÍVEL DE COMPLEXIDADE DESEJADO: "+
                                    descNivel[nivel]+" "+
                                    "REGRAS IMPORTANTES: responda APENAS com o texto final da redação, "+
                                    "SEM títulos, SEM explicações, SEM marcadores, SEM introdução do tipo "+
                                    "'aqui está sua redação'. Apenas o texto puro. "+
                                    "Parágrafos separados por uma linha em branco. "+
                                    "Tamanho aproximado: entre 25 e 35 linhas."

                            },

                            {

                                role:"user",

                                content:
                                    "CONTEÚDO DA PÁGINA:\n\n"+
                                    pageText

                            }

                        ]

                    })

                }
            );


        const dados=
            await resposta.json();


        if(!resposta.ok){

            if(
                resposta.status===401 ||
                resposta.status===403
            ){

                apiKey="";
            }

            throw new Error(
                dados?.error?.message ||
                "Erro HTTP "+
                resposta.status
            );

        }


        let texto=
            dados
            ?.choices
            ?.[0]
            ?.message
            ?.content;


        if(!texto){

            throw new Error(
                "A IA não retornou uma resposta."
            );

        }


        texto=
            texto
            .replace(/^```[\w]*\n?/,"")
            .replace(/```$/,"")
            .trim();


        $("pgGerar").textContent=
            "⌨️ DIGITANDO...";

        notify("Digitando redação...",true);


        await digitar(campo,texto);

        notify("Redação pronta!");

        $("pgGerar").textContent=
            "✍️ GERAR REDAÇÃO";

        $("pgGerar").disabled=false;


    }catch(erro){

        notify("Erro");

        alert(
            "Erro ao gerar redação:\n\n"+
            erro.message
        );


        $("pgGerar").textContent=
            "✍️ GERAR REDAÇÃO";

        $("pgGerar").disabled=false;

    }

};


// ==============================
// MINIMIZAR
// ==============================

toggle.onclick=()=>{

    if(
        toggle.dataset.dragged===
        "true"
    ){

        toggle.dataset.dragged=
        "false";

        return;

    }

    minimized=!minimized;

    gui.classList.toggle(
        "pgMini",
        minimized
    );

};


// ==============================
// ARRASTAR BOTÃO
// ==============================

let toggleDragging=false;
let toggleMoved=false;

let toggleOffsetX=0;
let toggleOffsetY=0;


toggle.addEventListener(
    "mousedown",
    event=>{

        toggleDragging=true;

        toggleMoved=false;

        toggleOffsetX=
            event.clientX-
            toggle.offsetLeft;

        toggleOffsetY=
            event.clientY-
            toggle.offsetTop;

        event.preventDefault();

    }
);


document.addEventListener(
    "mousemove",
    event=>{

        if(!toggleDragging)return;

        toggleMoved=true;

        toggle.style.left=
            event.clientX-
            toggleOffsetX+
            "px";

        toggle.style.top=
            event.clientY-
            toggleOffsetY+
            "px";

        toggle.style.right="auto";
        toggle.style.bottom="auto";

    }
);


document.addEventListener(
    "mouseup",
    ()=>{

        if(!toggleDragging)return;

        if(toggleMoved){

            toggle.dataset.dragged=
            "true";

        }

        toggleDragging=false;

    }
);


// ==============================
// CELULAR
// ==============================

toggle.addEventListener(
    "touchstart",
    event=>{

        const touch=
            event.touches[0];

        toggleDragging=true;

        toggleMoved=false;

        toggleOffsetX=
            touch.clientX-
            toggle.offsetLeft;

        toggleOffsetY=
            touch.clientY-
            toggle.offsetTop;

    },
    {passive:true}
);


document.addEventListener(
    "touchmove",
    event=>{

        if(!toggleDragging)return;

        const touch=
            event.touches[0];

        toggleMoved=true;

        toggle.style.left=
            touch.clientX-
            toggleOffsetX+
            "px";

        toggle.style.top=
            touch.clientY-
            toggleOffsetY+
            "px";

        toggle.style.right="auto";
        toggle.style.bottom="auto";

    },
    {passive:true}
);


document.addEventListener(
    "touchend",
    ()=>{

        if(!toggleDragging)return;

        if(toggleMoved){

            toggle.dataset.dragged=
            "true";

        }

        toggleDragging=false;

    }
);


// ==============================
// ARRASTAR GUI
// ==============================

$("pgHead").addEventListener(
    "mousedown",
    event=>{

        dragging=true;

        offsetX=
            event.clientX-
            gui.offsetLeft;

        offsetY=
            event.clientY-
            gui.offsetTop;

        event.preventDefault();

    }
);


document.addEventListener(
    "mousemove",
    event=>{

        if(!dragging)return;

        gui.style.left=
            event.clientX-
            offsetX+
            "px";

        gui.style.top=
            event.clientY-
            offsetY+
            "px";

        gui.style.transform=
            "scale(1)";

    }
);


document.addEventListener(
    "mouseup",
    ()=>{

        dragging=false;

    }
);


// ==============================
// GUI NO CELULAR
// ==============================

let touchDragging=false;

let touchOffsetX=0;
let touchOffsetY=0;


$("pgHead").addEventListener(
    "touchstart",
    event=>{

        const touch=
            event.touches[0];

        touchDragging=true;

        touchOffsetX=
            touch.clientX-
            gui.offsetLeft;

        touchOffsetY=
            touch.clientY-
            gui.offsetTop;

    },
    {passive:true}
);


document.addEventListener(
    "touchmove",
    event=>{

        if(!touchDragging)return;

        const touch=
            event.touches[0];

        gui.style.left=
            touch.clientX-
            touchOffsetX+
            "px";

        gui.style.top=
            touch.clientY-
            touchOffsetY+
            "px";

        gui.style.transform=
            "scale(1)";

    },
    {passive:true}
);


document.addEventListener(
    "touchend",
    ()=>{

        touchDragging=false;

    }
);


// ==============================
// ESC / ALT
// ==============================

function toggleHiddenMode(){

    hidden=!hidden;

    if(hidden){

        gui.style.display="none";
        toggle.style.display="none";
        notifyBox.style.display="none";

    }else{

        gui.style.display="";
        toggle.style.display="";
        notifyBox.style.display="";

    }

}


document.addEventListener(
    "keydown",
    event=>{

        if(event.key==="Escape"){

            minimized=!minimized;

            gui.classList.toggle(
                "pgMini",
                minimized
            );

        }

        if(event.key==="Alt"){

            toggleHiddenMode();

        }

    }
);


// ==============================
// BOTÃO CENTRAL
// ==============================

document.addEventListener(
    "mousedown",
    event=>{

        if(event.button!==1)return;

        event.preventDefault();

        toggleHiddenMode();

    }
);

})();