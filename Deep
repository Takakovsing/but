    // ==============================
    // KEY
    // ==============================

    const KEY_CORRETA = "rzinmodder";
    const key = prompt("Digite a Key:");
    if (key !== KEY_CORRETA) {
        alert("Key inválida!");
        return;
    }

    if (document.getElementById("pgMonitor")) {
