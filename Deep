javascript:(async()=>{

const KEY_CORRETA="rzinmodder";

const key=prompt("Digite a Key:");

if(key!==KEY_CORRETA){
    alert("Key inválida!");
    return;
}

if(document.getElementById("pgFloat"))return;

let minimized=false;
let typing=false;
let typingPaused=false;
let altHidden=false;

const favicon=document.createElement("link");

favicon.rel="icon";
favicon.href=
"https://media.tenor.com/m11vauEEbcUAAAAM/meow-neko-arc.gif";

document.head.appendChild(favicon);

const style=document.createElement("style");

style.textContent=`

body{
    filter:invert(1) hue-rotate(180deg)!important;
    transition:filter .45s ease!important;
}

#pgFloat,
#pgToggle,
#pgNotify{
    filter:invert(1) hue-rotate(180deg)!important;
}

#pgFloat{
    position:fixed;
    top:80px;
    left:50%;

    width:300px;
    padding:16px;

    box-sizing:border-box;

    background:rgba(20,20,20,.78);

    backdrop-filter:blur(15px);
    -webkit-backdrop-filter:blur(15px);

    color:#eee;

    border:1px solid rgba(255,255,255,.18);
    border-radius:20px;

    z-index:999999;

    font-family:"Trebuchet MS",Arial,sans-serif;

    box-shadow:0 15px 50px #000b;

    user-select:none;

    opacity:1;
    visibility:visible;

    transform:
        translateX(-50%)
        scale(1);

    transition:
        opacity .3s ease,
        transform .35s cubic-bezier(.2,.8,.2,1),
        visibility .35s ease;
}

#pgFloat.pgMini{
    opacity:0;
    visibility:hidden;

    transform:
        translateX(-50%)
        scale(.82);
}

#pgHead{
    height:32px;

    display:flex;
    align-items:center;
    justify-content:center;

    font-size:18px;
    font-weight:bold;

    letter-spacing:1px;

    cursor:move;

    margin-bottom:12px;

    user-select:none;
    touch-action:none;
}

#pgLine{
    height:1px;

    background:rgba(255,255,255,.2);

    margin-bottom:14px;
}

#pgFloat button{
    width:100%;

    border:1px solid rgba(255,255,255,.12);

    border-radius:12px;

    padding:12px;

    margin-top:9px;

    background:rgba(255,255,255,.12);

    color:#eee;

    font-family:
        "Trebuchet MS",
        Arial,
        sans-serif;

    font-weight:bold;

    font-size:14px;

    cursor:pointer;

    transition:
        background .2s ease,
        transform .2s ease,
        box-shadow .2s ease;
}

#pgFloat button:hover{
    background:rgba(255,255,255,.2);

    transform:translateY(-2px);

    box-shadow:0 6px 18px #0005;
}

#pgFloat button:active{
    transform:scale(.97);
}

#pgToggle{
    position:fixed;

    right:20px;
    bottom:25px;

    width:62px;
    height:62px;

    border-radius:50%;

    background:#111;

    border:2px solid #555;

    z-index:1000000;

    box-shadow:0 8px 30px #000b;

    cursor:pointer;

    overflow:hidden;

    display:flex;

    align-items:center;
    justify-content:center;

    user-select:none;
    touch-action:none;
}

#pgToggle img{
    width:100%;
    height:100%;

    object-fit:cover;

    display:block;

    pointer-events:none;
}

#pgNotify{
    position:fixed;

    top:25px;
    left:50%;

    transform:
        translateX(-50%)
        translateY(-20px);

    background:#555;

    color:#fff;

    padding:11px 25px;

    border-radius:10px;

    font-family:
        "Trebuchet MS",
        Arial,
        sans-serif;

    font-weight:bold;

    font-size:15px;

    z-index:1000001;

    opacity:0;

    transition:
        opacity .3s ease,
        transform .35s ease;

    box-shadow:0 8px 25px #0008;

    pointer-events:none;
}

`;

document.head.appendChild(style);


// ==============================
// GUI
// ==============================

const gui=document.createElement("div");

gui.id="pgFloat";

gui.innerHTML=`

<div id="pgHead">
    PORTUGA TOOLS
</div>

<div id="pgLine"></div>

<button id="pgType">
    INSERIR TEXTO
</button>

<button id="pgCopy">
    FORÇAR CÓPIA
</button>

`;

document.body.appendChild(gui);


// ==============================
// BOTÃO FLUTUANTE
// ==============================

const toggle=document.createElement("div");

toggle.id="pgToggle";

toggle.innerHTML=`

<img src="https://media.tenor.com/m11vauEEbcUAAAAM/meow-neko-arc.gif">

`;

document.body.appendChild(toggle);


// ==============================
// NOTIFICAÇÃO
// ==============================

const notifyBox=document.createElement("div");

notifyBox.id="pgNotify";

notifyBox.textContent="Feito!!";

document.body.appendChild(notifyBox);

const $=id=>document.getElementById(id);


// ==============================
// NOTIFICAÇÃO
// ==============================

function notify(){

    notifyBox.style.opacity="1";

    notifyBox.style.transform=
        "translateX(-50%) translateY(0)";

    setTimeout(()=>{

        notifyBox.style.opacity="0";

        notifyBox.style.transform=
            "translateX(-50%) translateY(-20px)";

    },1800);
}


// ==============================
// FORÇAR CÓPIA
// ==============================

$("pgCopy").onclick=async()=>{

    const selected=
        window.getSelection().toString();

    if(!selected){

        alert(
            "Selecione algum texto primeiro!"
        );

        return;
    }

    try{

        await navigator.clipboard.writeText(
            selected
        );

    }catch(e){

        const temp=
            document.createElement("textarea");

        temp.value=selected;

        document.body.appendChild(temp);

        temp.select();

        document.execCommand("copy");

        temp.remove();
    }

    notify();
};


// ==============================
// ESPERAR PELO TEXTAREA
// MESMA LÓGICA DO SCRIPT ORIGINAL
// ==============================

function esperarTextarea(){

    return new Promise(resolve=>{

        const existente=
            document.querySelector("textarea");

        if(existente){

            resolve(existente);
            return;
        }

        const intervalo=
            setInterval(()=>{

                const campo=
                    document.querySelector("textarea");

                if(campo){

                    clearInterval(intervalo);

                    resolve(campo);
                }

            },500);

    });
}


// ==============================
// DIGITAR TEXTO
// ==============================

$("pgType").onclick=async()=>{

    const text=
        prompt(
            "Digite o texto que será digitado automaticamente:"
        );

    if(text===null || !text){

        alert(
            "Nenhum texto foi digitado."
        );

        return;
    }

    typing=true;
    typingPaused=false;

    const field=
        await esperarTextarea();

    if(!typing)
        return;

    field.focus();

    for(const char of text){

        while(
            typingPaused &&
            typing
        ){

            await new Promise(
                resolve=>
                    setTimeout(
                        resolve,
                        50
                    )
            );
        }

        if(!typing)
            return;

        field.setRangeText(
            char,
            field.selectionStart,
            field.selectionEnd,
            "end"
        );

        field.dispatchEvent(
            new KeyboardEvent(
                "keydown",
                {
                    key:char,
                    bubbles:true
                }
            )
        );

        field.dispatchEvent(
            new InputEvent(
                "input",
                {
                    bubbles:true,
                    data:char,
                    inputType:"insertText"
                }
            )
        );

        field.dispatchEvent(
            new KeyboardEvent(
                "keyup",
                {
                    key:char,
                    bubbles:true
                }
            )
        );

        await new Promise(
            resolve=>
                setTimeout(
                    resolve,
                    20
                )
        );
    }

    typing=false;

    if(!altHidden){

        notify();
    }
};


// ==============================
// MINIMIZAR / ABRIR
// ==============================

toggle.onclick=()=>{

    if(
        toggle.dataset.dragged===
        "true"
    ){

        toggle.dataset.dragged=
            "false";

        return;
    }

    minimized=!minimized;

    gui.classList.toggle(
        "pgMini",
        minimized
    );
};


// ==============================
// ARRASTAR BOTÃO
// ==============================

let toggleDragging=false;
let toggleMoved=false;

let toggleOffsetX=0;
let toggleOffsetY=0;

toggle.addEventListener(
    "mousedown",
    event=>{

        toggleDragging=true;
        toggleMoved=false;

        toggleOffsetX=
            event.clientX-
            toggle.offsetLeft;

        toggleOffsetY=
            event.clientY-
            toggle.offsetTop;

        event.preventDefault();
    }
);

document.addEventListener(
    "mousemove",
    event=>{

        if(!toggleDragging)
            return;

        toggleMoved=true;

        toggle.style.left=
            event.clientX-
            toggleOffsetX+
            "px";

        toggle.style.top=
            event.clientY-
            toggleOffsetY+
            "px";

        toggle.style.right="auto";
        toggle.style.bottom="auto";
    }
);

document.addEventListener(
    "mouseup",
    ()=>{

        if(!toggleDragging)
            return;

        if(toggleMoved){

            toggle.dataset.dragged=
                "true";
        }

        toggleDragging=false;
    }
);


// ==============================
// CELULAR
// ==============================

toggle.addEventListener(
    "touchstart",
    event=>{

        const touch=
            event.touches[0];

        toggleDragging=true;
        toggleMoved=false;

        toggleOffsetX=
            touch.clientX-
            toggle.offsetLeft;

        toggleOffsetY=
            touch.clientY-
            toggle.offsetTop;

    },
    {
        passive:true
    }
);

document.addEventListener(
    "touchmove",
    event=>{

        if(!toggleDragging)
            return;

        const touch=
            event.touches[0];

        toggleMoved=true;

        toggle.style.left=
            touch.clientX-
            toggleOffsetX+
            "px";

        toggle.style.top=
            touch.clientY-
            toggleOffsetY+
            "px";

        toggle.style.right="auto";
        toggle.style.bottom="auto";

    },
    {
        passive:true
    }
);

document.addEventListener(
    "touchend",
    ()=>{

        if(!toggleDragging)
            return;

        if(toggleMoved){

            toggle.dataset.dragged=
                "true";
        }

        toggleDragging=false;
    }
);


// ==============================
// ARRASTAR GUI
// ==============================

let dragging=false;

let offsetX=0;
let offsetY=0;

$("pgHead").addEventListener(
    "mousedown",
    event=>{

        dragging=true;

        offsetX=
            event.clientX-
            gui.offsetLeft;

        offsetY=
            event.clientY-
            gui.offsetTop;

        event.preventDefault();
    }
);

document.addEventListener(
    "mousemove",
    event=>{

        if(!dragging)
            return;

        gui.style.left=
            event.clientX-
            offsetX+
            "px";

        gui.style.top=
            event.clientY-
            offsetY+
            "px";

        gui.style.transform=
            "scale(1)";
    }
);

document.addEventListener(
    "mouseup",
    ()=>{

        dragging=false;
    }
);


// ==============================
// CELULAR GUI
// ==============================

let touchDragging=false;

let touchOffsetX=0;
let touchOffsetY=0;

$("pgHead").addEventListener(
    "touchstart",
    event=>{

        const touch=
            event.touches[0];

        touchDragging=true;

        touchOffsetX=
            touch.clientX-
            gui.offsetLeft;

        touchOffsetY=
            touch.clientY-
            gui.offsetTop;

    },
    {
        passive:true
    }
);

document.addEventListener(
    "touchmove",
    event=>{

        if(!touchDragging)
            return;

        const touch=
            event.touches[0];

        gui.style.left=
            touch.clientX-
            touchOffsetX+
            "px";

        gui.style.top=
            touch.clientY-
            touchOffsetY+
            "px";

        gui.style.transform=
            "scale(1)";
    },
    {
        passive:true
    }
);

document.addEventListener(
    "touchend",
    ()=>{

        touchDragging=false;
    }
);


// ==============================
// ESCONDER / MOSTRAR
// ==============================

function toggleHiddenMode(){

    altHidden=!altHidden;

    if(altHidden){

        if(typing){

            typingPaused=true;
        }

        gui.style.display="none";

        toggle.style.display="none";

        notifyBox.style.display="none";

        document.body.style.filter="none";

    }else{

        gui.style.display="";

        toggle.style.display="";

        notifyBox.style.display="";

        document.body.style.filter=
            "invert(1) hue-rotate(180deg)";

        if(typing){

            typingPaused=false;
        }
    }
}


// ==============================
// ATALHOS
// ==============================

document.addEventListener(
    "keydown",
    event=>{

        if(event.key==="Escape"){

            minimized=!minimized;

            gui.classList.toggle(
                "pgMini",
                minimized
            );

            return;
        }

        if(event.key==="Control"){

            if(typing){

                typingPaused=
                    !typingPaused;

                if(typingPaused){

                    notifyBox.textContent=
                        "Digitação pausada";

                }else{

                    notifyBox.textContent=
                        "Digitação continuando";
                }

                if(!altHidden){

                    notify();
                }
            }

            return;
        }

        if(event.key==="Alt"){

            toggleHiddenMode();

            return;
        }
    }
);


// ==============================
// CLIQUE NO SCROLL
// ==============================

document.addEventListener(
    "mousedown",
    event=>{

        if(event.button!==1)
            return;

        event.preventDefault();

        toggleHiddenMode();
    }
);

})();
