javascript:(async()=>{
    if(window._r)return; window._r=1;

    let apiKey="";
    let nivel="medio";

    // ============ STYLE ============
    const style=document.createElement("style");
    style.textContent=`
        #rwGui{position:fixed;bottom:20px;right:20px;z-index:2147483647;
            font-family:system-ui,Arial,sans-serif;display:flex;flex-direction:column;
            gap:8px;user-select:none}
        #rwGui button{border:1px solid rgba(255,255,255,.15);
            background:rgba(20,20,20,.9);backdrop-filter:blur(10px);color:#eee;
            padding:12px 18px;border-radius:12px;font-size:14px;font-weight:bold;
            cursor:pointer;box-shadow:0 8px 24px #0008;transition:.2s}
        #rwGui button:hover{background:rgba(50,50,50,.95);transform:translateY(-2px)}
        #rwGui button:active{transform:scale(.96)}
        #rwGui button:disabled{opacity:.6;cursor:wait}
        #rwStatus{position:fixed;bottom:20px;left:20px;background:rgba(20,20,20,.9);
            color:#eee;padding:10px 16px;border-radius:10px;font-family:system-ui,Arial,
            sans-serif;font-size:13px;z-index:2147483647;opacity:0;transition:.3s;
            pointer-events:none;max-width:280px}
    `;
    document.head.appendChild(style);

    // ============ GUI ============
    const gui=document.createElement("div");
    gui.id="rwGui";
    gui.innerHTML=`
        <button id="rwGerar">✍️ Gerar Redação</button>
        <button id="rwNivel">🎚️ Nível: Médio</button>
    `;
    document.body.appendChild(gui);

    const status=document.createElement("div");
    status.id="rwStatus";
    document.body.appendChild(status);

    const $=id=>document.getElementById(id);

    function notify(t,persist){
        status.textContent=t; status.style.opacity="1";
        clearTimeout(notify._t);
        if(!persist) notify._t=setTimeout(()=>status.style.opacity="0",2500);
    }

    // ============ NÍVEIS ============
    const niveis=["baixo","medio","alto"];
    const nomes={baixo:"Baixo",medio:"Médio",alto:"Alto"};
    const descricao={
        baixo:"Linguagem simples, frases curtas, vocabulário básico, estrutura direta e objetiva.",
        medio:"Vocabulário intermediário, algumas figuras de linguagem, boa coesão, argumentação equilibrada.",
        alto:"Vocabulário rebuscado, argumentação sofisticada, repertório sociocultural, conectivos variados, alta coesão."
    };

    $("rwNivel").onclick=()=>{
        const i=niveis.indexOf(nivel);
        nivel=niveis[(i+1)%niveis.length];
        $("rwNivel").textContent="🎚️ Nível: "+nomes[nivel];
    };

    // ============ LER PÁGINA ============
    function lerPagina(){
        const clone=document.body.cloneNode(true);
        ["#rwGui","#rwStatus","script","style","noscript"].forEach(s=>{
            clone.querySelectorAll(s).forEach(e=>e.remove());
        });
        return clone.innerText.replace(/\n{3,}/g,"\n\n").trim().slice(0,50000);
    }

    // ============ ACHAR CAMPO ============
    function acharCampo(){
        const areas=[...document.querySelectorAll("textarea")]
            .filter(e=>e.offsetParent!==null);
        if(areas.length){
            return areas.sort((a,b)=>
                (b.clientHeight*b.clientWidth)-(a.clientHeight*a.clientWidth)
            )[0];
        }
        const edit=[...document.querySelectorAll('[contenteditable="true"]')]
            .filter(e=>e.offsetParent!==null);
        return edit[0]||null;
    }

    // ============ SETTER NATIVO (React/Vue) ============
    function setNative(el,val){
        const proto=el.tagName==="TEXTAREA"
            ? HTMLTextAreaElement.prototype
            : HTMLInputElement.prototype;
        const setter=Object.getOwnPropertyDescriptor(proto,"value").set;
        setter.call(el,val);
        el.dispatchEvent(new Event("input",{bubbles:true}));
    }

    // ============ DIGITAR ============
    async function digitar(campo,texto){
        campo.focus();

        if(campo.tagName==="TEXTAREA"||campo.tagName==="INPUT"){
            setNative(campo,"");
            let acumulado="";
            for(let i=0;i<texto.length;i++){
                acumulado+=texto[i];
                setNative(campo,acumulado);
                if(i%20===0) await new Promise(r=>setTimeout(r,12));
            }
            campo.dispatchEvent(new Event("change",{bubbles:true}));
        }else{
            // contenteditable
            campo.innerHTML="";
            campo.dispatchEvent(new InputEvent("input",{bubbles:true}));
            for(let i=0;i<texto.length;i++){
                document.execCommand("insertText",false,texto[i]);
                if(i%20===0) await new Promise(r=>setTimeout(r,12));
            }
        }
    }

    // ============ GERAR ============
    $("rwGerar").onclick=async()=>{
        if(!apiKey){
            apiKey=prompt("Cole sua chave do OpenRouter:");
            if(!apiKey) return;
        }

        const campo=acharCampo();
        if(!campo){
            alert("Não encontrei nenhum campo de texto na página!");
            return;
        }

        $("rwGerar").disabled=true;
        notify("📖 Lendo página...",true);

        const pageText=lerPagina();
        if(!pageText){
            alert("Não consegui ler o conteúdo da página!");
            $("rwGerar").disabled=false;
            return;
        }

        notify("🤖 Gerando redação (nível "+nomes[nivel]+")...",true);

        try{
            const resp=await fetch("https://openrouter.ai/api/v1/chat/completions",{
                method:"POST",
                headers:{
                    "Authorization":"Bearer "+apiKey,
                    "Content-Type":"application/json"
                },
                body:JSON.stringify({
                    model:"openrouter/free",
                    messages:[
                        {
                            role:"system",
                            content:
                                "Você é um especialista em redações. "+
                                "PRIMEIRO identifique o TEMA da redação a partir do conteúdo da página. "+
                                "DEPOIS escreva uma redação completa em português sobre esse tema. "+
                                "NÍVEL DE COMPLEXIDADE DESEJADO: "+descricao[nivel]+" "+
                                "REGRAS IMPORTANTES: responda APENAS com o texto final da redação, "+
                                "SEM títulos, SEM explicações, SEM marcadores, SEM introdução do tipo "+
                                "'aqui está sua redação'. Apenas o texto puro. "+
                                "Parágrafos separados por uma linha em branco. "+
                                "Tamanho aproximado: entre 25 e 35 linhas."
                        },
                        {
                            role:"user",
                            content:"CONTEÚDO DA PÁGINA:\n\n"+pageText
                        }
                    ]
                })
            });

            const dados=await resp.json();

            if(!resp.ok){
                if(resp.status===401||resp.status===403) apiKey="";
                throw new Error(dados?.error?.message||"Erro HTTP "+resp.status);
            }

            let texto=dados?.choices?.[0]?.message?.content;
            if(!texto) throw new Error("A IA não retornou resposta.");

            // limpa cercas markdown caso venham
            texto=texto.replace(/^```[\w]*\n?/,"").replace(/```$/,"").trim();

            notify("⌨️ Digitando redação...",true);
            await digitar(campo,texto);
            notify("✅ Redação pronta!");

        }catch(e){
            notify("❌ Erro");
            alert("Erro:\n\n"+e.message);
        }finally{
            $("rwGerar").disabled=false;
        }
    };
})();