        const campo = acharCampo();

        if (!campo) {
            alert("Não encontrei um campo de texto editável nesta página.");
            return;
        }

        const pageText = lerPagina();

        if (!pageText) {
            alert("Não consegui ler o conteúdo da página.");
            return;
        }

        if (!apiKey) {
            const entrada = prompt(
                "Cole sua API Key da OpenRouter ou da OpenAI:"
            );

            if (!entrada || !entrada.trim()) return;
            apiKey = entrada.trim();
        }

        busy = true;

        const btn = $("pgGerar");
        btn.disabled = true;
        btn.innerHTML =
            `<span class="pgButtonIcon">✦</span><span>GERANDO...</span>`;

        definirGeracao(true);
        setStatus("Preparando sua redação...", true);
        notify("A IA está preparando sua redação...", true);

        try {
            let texto;
            let tentativas = 0;

            while (true) {
                try {
                    texto = await gerarRedacao(apiKey, pageText);
                    break;
                } catch (erro) {
                    const podeTrocar =
                        erro.codigoApi === "COTA" ||
                        erro.codigoApi === "CHAVE_INVALIDA";

                    if (!podeTrocar || tentativas >= 2) throw erro;

                    tentativas++;
                    await solicitarChave(erro.codigoApi);
                    notify("Testando a nova API Key...", true);
                }
            }

            aplicarTexto(campo, texto);
            notify("Redação gerada e preenchida!");
            setStatus("Redação preenchida com sucesso");
        } catch (erro) {
            console.error("[PORTUGA IA]", erro);

            if (erro.codigoApi === "CANCELADO") {
                notify("Troca de API cancelada.");
                setStatus("Operação cancelada");
            } else {
                notify("Não foi possível gerar a redação.");
                setStatus("Erro ao gerar redação");

                alert(
                    "Erro ao gerar redação:\n\n" +
                    (erro?.message || "Erro desconhecido") +
                    "\n\nConfira sua API Key, a cota e o modelo."
                );
            }
        } finally {
            busy = false;
            btn.disabled = false;
            btn.innerHTML =
                `<span class="pgButtonIcon">✦</span><span>GERAR REDAÇÃO</span>`;
            definirGeracao(false);
        }
    });

    // Arrastar o ícone flutuante. Um toque simples minimiza/reabre.
    toggle.addEventListener("pointerdown", e => {
        if (e.button !== undefined && e.button !== 0) return;

        togglePointer = {
            id: e.pointerId,
            x: e.clientX,
            y: e.clientY,
            left: toggle.getBoundingClientRect().left,
            top: toggle.getBoundingClientRect().top,
            moved: false
        };

        try { toggle.setPointerCapture(e.pointerId); } catch (_) {}
        e.preventDefault();
    });

    toggle.addEventListener("pointermove", e => {
        if (!togglePointer || togglePointer.id !== e.pointerId) return;

        const dx = e.clientX - togglePointer.x;
        const dy = e.clientY - togglePointer.y;

        if (Math.abs(dx) > 5 || Math.abs(dy) > 5) {
            togglePointer.moved = true;
        }

        if (!togglePointer.moved) return;

        const left = Math.max(
            4,
            Math.min(
                window.innerWidth - toggle.offsetWidth - 4,
                togglePointer.left + dx
            )
        );

        const top = Math.max(
            4,
            Math.min(
                window.innerHeight - toggle.offsetHeight - 4,
                togglePointer.top + dy
            )
        );

        toggle.style.left = left + "px";
        toggle.style.top = top + "px";
        toggle.style.right = "auto";
        toggle.style.bottom = "auto";
    });

    toggle.addEventListener("pointerup", e => {
        if (!togglePointer || togglePointer.id !== e.pointerId) return;

        const arrastou = togglePointer.moved;
        togglePointer = null;

        if (!arrastou) definirMinimizado(!minimized);
    });

    toggle.addEventListener("pointercancel", () => {
        togglePointer = null;
    });

    // Arrastar o painel pela barra do título.
    const head = $("pgHead");

    head.addEventListener("pointerdown", e => {
        if (e.button !== undefined && e.button !== 0) return;
        if (e.target.closest("#pgEditApi")) return;

        const rect = gui.getBoundingClientRect();

        panelDrag = {
            id: e.pointerId,
            x: e.clientX,
            y: e.clientY,
            left: rect.left,
            top: rect.top
        };

        gui.style.left = rect.left + "px";
        gui.style.top = rect.top + "px";
        gui.style.transform = "none";

        try { head.setPointerCapture(e.pointerId); } catch (_) {}
        e.preventDefault();
    });

    head.addEventListener("pointermove", e => {
        if (!panelDrag || panelDrag.id !== e.pointerId) return;

        const dx = e.clientX - panelDrag.x;
        const dy = e.clientY - panelDrag.y;

        gui.style.left = Math.max(
            4,
            Math.min(
                window.innerWidth - gui.offsetWidth - 4,
                panelDrag.left + dx
            )
        ) + "px";

        gui.style.top = Math.max(
            4,
            Math.min(
                window.innerHeight - gui.offsetHeight - 4,
                panelDrag.top + dy
            )
        ) + "px";
    });

    function pararArrastePainel() {
        panelDrag = null;
    }

    head.addEventListener("pointerup", pararArrastePainel);
    head.addEventListener("pointercancel", pararArrastePainel);

    // Redimensionamento responsivo.
    window.addEventListener("resize", () => {
        const limitar = elemento => {
            const rect = elemento.getBoundingClientRect();

            elemento.style.left = Math.max(
                4,
                Math.min(window.innerWidth - rect.width - 4, rect.left)
            ) + "px";

            elemento.style.top = Math.max(
                4,
                Math.min(window.innerHeight - rect.height - 4, rect.top)
            ) + "px";
        };

        if (gui.style.transform === "none") limitar(gui);
        if (toggle.style.left) limitar(toggle);
    });

    // Atalhos: Esc minimiza/reabre; Alt esconde/mostra tudo.
    document.addEventListener("keydown", e => {
        if (e.key === "Escape") definirMinimizado(!minimized);

        if (e.key === "Alt" && !e.repeat) {
            hidden = !hidden;
            gui.style.display = hidden ? "none" : "";
            toggle.style.display = hidden ? "none" : "";
            notifyBox.style.display = hidden ? "none" : "";
        }
    });

    document.addEventListener("mousedown", e => {
        if (e.button !== 1) return;

        e.preventDefault();
        hidden = !hidden;
        gui.style.display = hidden ? "none" : "";
        toggle.style.display = hidden ? "none" : "";
        notifyBox.style.display = hidden ? "none" : "";
    });

    notify("PORTUGA IA Premium V2 iniciada!");
})();
