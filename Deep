    // ==============================
    // FORÇAR CÓPIA
    // ==============================

    $("pgCopy").onclick = async function () {
        const selected = window.getSelection().toString();
        if (!selected) {
            alert("Selecione algum texto primeiro!");
            return;
        }

        try {
            // Tenta copiar pelo clipboard API
            await navigator.clipboard.writeText(selected);
        } catch (e) {
            try {
                // Fallback: execCommand
                const temp = document.createElement("textarea");
                temp.value = selected;
                document.body.appendChild(temp);
                temp.select();
                document.execCommand("copy");
                temp.remove();
            } catch (e2) {
                // Fallback final: prompt
                prompt("Copie o texto manualmente:", selected);
            }
        }
        notify("Texto copiado!");
    };

    // ==============================
    // DIGITAR TEXTO
    // ==============================

    $("pgType").onclick = async function () {
        const text = $("pgText").value;
        if (!text) {
            alert("Digite algum texto primeiro!");
            return;
        }

        const fields = document.querySelectorAll("textarea:not(#pgText), input");
        if (!fields.length) {
            alert("Nenhuma caixa de texto foi encontrada!");
            return;
        }

        const field = fields[0];
        typing = true;
        typingPaused = false;
        field.focus();

        for (const char of text) {
            while (typingPaused && typing) {
                await new Promise(resolve => setTimeout(resolve, 50));
            }
            if (!typing) return;

            field.setRangeText(char, field.selectionStart, field.selectionEnd, "end");
            field.dispatchEvent(new InputEvent("input", {
                bubbles: true,
                data: char,
                inputType: "insertText"
            }));
            await new Promise(resolve => setTimeout(resolve, 20));
        }

        typing = false;
        if (!altHidden) notify("Texto digitado!");
    };

