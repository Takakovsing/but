local function readIndex()
    if not isfile(INDEX_FILE) then return {} end
    local ok, data = pcall(function()
        return HttpService:JSONDecode(readfile(INDEX_FILE))
    end)
    if ok and type(data) == "table" then return data end
    return {}
end

local function writeIndex(list)
    pcall(function()
        writefile(INDEX_FILE, HttpService:JSONEncode(list))
    end)
end

local function indexAdd(name)
    local list = readIndex()
    for _, n in ipairs(list) do
        if n == name then return end
    end
    table.insert(list, name)
    table.sort(list)
    writeIndex(list)
end

local function indexRemove(name)
    local list = readIndex()
    for i, n in ipairs(list) do
        if n == name then
            table.remove(list, i)
            break
        end
    end
    writeIndex(list)
end

local function getSaveList()
    local list = readIndex()
    local valid = {}
    for _, name in ipairs(list) do
        local path = SAVE_PREFIX .. name .. SAVE_EXT
        if isfile(path) then
            table.insert(valid, name)
        end
    end
    if #valid ~= #list then writeIndex(valid) end
    return valid
end

