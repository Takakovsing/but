local function criarSwitch(parent)
    local switch=Instance.new("TextButton",parent)
    switch.Size=UDim2.new(0,56,0,28)
    switch.BackgroundColor3=Color3.fromRGB(20,20,23)
    switch.BorderSizePixel=0
    switch.Text=""
    switch.AutoButtonColor=false
    switch.ZIndex=20
    Instance.new("UICorner",switch).CornerRadius=UDim.new(0,8)
    local border=Instance.new("UIStroke",switch)
    border.Color=Color3.fromRGB(100,100,105)
    border.Thickness=1.2
    border.Transparency=0.25
    local onText=Instance.new("TextLabel",switch)
    onText.Size=UDim2.new(0,25,1,0)
    onText.Position=UDim2.new(0,2,0,0)
    onText.BackgroundTransparency=1
    onText.Text="ON"
    onText.Font=Enum.Font.GothamBold
    onText.TextSize=8
    onText.TextColor3=RED
    onText.TextTransparency=1
    onText.ZIndex=21
    local offText=Instance.new("TextLabel",switch)
    offText.Size=UDim2.new(0,27,1,0)
    offText.Position=UDim2.new(0,29,0,0)
    offText.BackgroundTransparency=1
    offText.Text="OFF"
    offText.Font=Enum.Font.GothamBold
    offText.TextSize=8
    offText.TextColor3=Color3.fromRGB(145,145,150)
    offText.ZIndex=21
    local knob=Instance.new("Frame",switch)
    knob.Size=UDim2.new(0,22,0,22)
    knob.Position=UDim2.new(0,3,0.5,-11)
    knob.BackgroundColor3=Color3.fromRGB(180,180,185)
    knob.BorderSizePixel=0
    knob.ZIndex=22
    Instance.new("UICorner",knob).CornerRadius=UDim.new(0,6)
    local knobStroke=Instance.new("UIStroke",knob)
    knobStroke.Color=Color3.fromRGB(255,255,255)
    knobStroke.Thickness=1
    knobStroke.Transparency=0.65
    local ligado=false
    local callbacks={}
    local api={}
    registerTheme(function(c)
        onText.TextColor3=c
        if ligado then switch.BackgroundColor3=darken(c,0.2); border.Color=c; border.Transparency=0 end
    end)
    function api.getState() return ligado end
    function api.onToggle(fn) table.insert(callbacks,fn) end
    function api.setVisual(v)
        ligado=v
        if ligado then
            switch.BackgroundColor3=darken(RED,0.2); border.Color=RED; border.Transparency=0
            knob.Position=UDim2.new(1,-25,0.5,-11); knob.BackgroundColor3=Color3.fromRGB(255,255,255)
            onText.TextTransparency=0; offText.TextTransparency=1
        else
            switch.BackgroundColor3=Color3.fromRGB(20,20,23); border.Color=Color3.fromRGB(100,100,105); border.Transparency=0.25
            knob.Position=UDim2.new(0,3,0.5,-11); knob.BackgroundColor3=Color3.fromRGB(180,180,185)
            onText.TextTransparency=1; offText.TextTransparency=0
        end
    end
    switch.MouseButton1Click:Connect(function()
        ligado=not ligado
        local dark=darken(RED,0.2)
        if ligado then
            TS:Create(switch,smallTween,{BackgroundColor3=dark}):Play()
            TS:Create(border,smallTween,{Color=RED,Transparency=0}):Play()
            TS:Create(knob,drawerTween,{Position=UDim2.new(1,-25,0.5,-11),BackgroundColor3=Color3.fromRGB(255,255,255)}):Play()
            TS:Create(onText,smallTween,{TextTransparency=0}):Play()
            TS:Create(offText,smallTween,{TextTransparency=1}):Play()
        else
            TS:Create(switch,smallTween,{BackgroundColor3=Color3.fromRGB(20,20,23)}):Play()
            TS:Create(border,smallTween,{Color=Color3.fromRGB(100,100,105),Transparency=0.25}):Play()
            TS:Create(knob,drawerTween,{Position=UDim2.new(0,3,0.5,-11),BackgroundColor3=Color3.fromRGB(180,180,185)}):Play()
            TS:Create(onText,smallTween,{TextTransparency=1}):Play()
            TS:Create(offText,smallTween,{TextTransparency=0}):Play()
        end
        for _,fn in ipairs(callbacks) do pcall(fn,ligado) end
    end)
    api.frame=switch
    return api
end

-- TEXTBOX
local function criarTextBox(parent,valorInicial)
    local box=Instance.new("TextButton",parent)
    box.Size=UDim2.new(0,70,0,28)
    box.BackgroundColor3=Color3.fromRGB(20,20,23)
    box.BorderSizePixel=0
    box.Text=""
    box.AutoButtonColor=false
    box.ZIndex=20
    Instance.new("UICorner",box).CornerRadius=UDim.new(0,8)
    local border=Instance.new("UIStroke",box)
    border.Color=Color3.fromRGB(100,100,105)
    border.Thickness=1.2
    border.Transparency=0.25
    local input=Instance.new("TextBox",box)
    input.Size=UDim2.new(1,-8,1,-4)
    input.Position=UDim2.new(0,4,0,2)
    input.BackgroundTransparency=1
    input.Text=tostring(valorInicial)
    input.Font=Enum.Font.GothamBold
    input.TextSize=10
    input.TextColor3=Color3.fromRGB(240,240,240)
    input.PlaceholderText="..."
    input.PlaceholderColor3=Color3.fromRGB(120,120,125)
    input.TextXAlignment=Enum.TextXAlignment.Center
    input.ClearTextOnFocus=false
    input.ZIndex=22
    local focused=false
    registerTheme(function(c)
        border.Color=c
        if focused then box.BackgroundColor3=darken(c,0.15) end
    end)
    local api={}
    function api.setValue(v) input.Text=tostring(v) end
    function api.getValue() return tonumber(input.Text) or 0 end
    function api.onSubmit(fn) input.FocusLost:Connect(function() fn(tonumber(input.Text) or 0) end) end
    input.Focused:Connect(function() focused=true; TS:Create(border,smallTween,{Transparency=0,Color=RED}):Play(); TS:Create(box,smallTween,{BackgroundColor3=darken(RED,0.15)}):Play() end)
    input.FocusLost:Connect(function() focused=false; TS:Create(border,smallTween,{Transparency=0.25,Color=Color3.fromRGB(100,100,105)}):Play(); TS:Create(box,smallTween,{BackgroundColor3=Color3.fromRGB(20,20,23)}):Play() end)
    api.frame=box
    api.input=input
    return api
end

