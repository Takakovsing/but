local function getTarget()
    local best=nil
    local bestDist=FOV
    local bestHP=math.huge
    local worstHP=-math.huge
    local farDist=0
    local pri=PRIORITY[priorityIndex]

    if aimToolEnabled then
        local t=PL.Character and PL.Character:FindFirstChildOfClass("Tool")
        if not t then return nil end
    end

    for _,p in pairs(PS:GetPlayers()) do
        if p~=PL and p.Character then
            local ch=p.Character
            local h=ch:FindFirstChild("Humanoid")
            local pt=ch:FindFirstChild(aimPart)
            if not h or not pt then continue end
            if h.Health<=0 then continue end
            if teamCheck and p.Team==PL.Team then continue end
            if friends[p.Name] then continue end
            if teamMiscEnabled and selectedTeam then if p.Team~=selectedTeam then continue end end
            local ps,v=CAM:WorldToViewportPoint(pt.Position)
            if v then
                local d=(Vector2.new(ps.X,ps.Y)-Vector2.new(CAM.ViewportSize.X/2,CAM.ViewportSize.Y/2)).Magnitude
                if d<FOV then
                    if wallCheck then
                        local rp=RaycastParams.new()
                        rp.FilterType=Enum.RaycastFilterType.Blacklist
                        rp.FilterDescendantsInstances={PL.Character}
                        local r=workspace:Raycast(CAM.CFrame.Position,(pt.Position-CAM.CFrame.Position).Unit*5000,rp)
                        if r and not r.Instance:IsDescendantOf(ch) then continue end
                    end
                    if pri=="CLOSEST" then if d<bestDist then bestDist=d; best=p end
                    elseif pri=="LOW HP" then if h.Health<bestHP then bestHP=h.Health; best=p end
                    elseif pri=="HIGH HP" then if h.Health>worstHP then worstHP=h.Health; best=p end
                    elseif pri=="FARTHEST" then if d>farDist then farDist=d; best=p end end
                end
            end
        end
    end
    return best
end

