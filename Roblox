                api = criarTextBoxButton(children, cfg.nome, cfg.valor, ordem)
            end
            if cfg.key and api then
                UI[cfg.key] = api
            end
        end
    end

    local data = {
        drawer = drawer,
        children = children,
        arrow = arrow,
        stroke = stroke,
        aberta = false,
        childrenHeight = childrenHeight,
        openHeight = openHeight,
    }

    table.insert(gavetas, data)

    header.MouseButton1Click:Connect(function()
        if data.aberta then
            fecharGaveta(data)
        else
