local npcCache = {}
local function isNPC(model)
    if not model or not model:IsA("Model") then return false end
    if Players:GetPlayerFromCharacter(model) then return false end
    if not model:FindFirstChildOfClass("Humanoid") then return false end
    if not model:FindFirstChild("HumanoidRootPart") then return false end
    return true
end

task.spawn(function()
    while true do
        local list = {}
        for _, obj in pairs(workspace:GetDescendants()) do
            if obj:IsA("Model") and isNPC(obj) then
                table.insert(list, obj)
            end
        end
        npcCache = list
        task.wait(1)
    end
end)

local function getNearestNPC(partName)
    local closest, shortest = nil, FOV
    for _, npc in pairs(npcCache) do
        local hum = npc:FindFirstChildOfClass("Humanoid")
        local part = npc:FindFirstChild(partName)
        if hum and part and hum.Health > 0 then
            local pos, vis = Camera:WorldToViewportPoint(part.Position)
            if vis then
                local dist = (Vector2.new(pos.X, pos.Y) - Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)).Magnitude
                if dist < shortest then
                    if wallCheck then
                        local rp = RaycastParams.new()
                        rp.FilterType = Enum.RaycastFilterType.Blacklist
                        rp.FilterDescendantsInstances = {Player.Character}
                        local ray = workspace:Raycast(Camera.CFrame.Position, (part.Position - Camera.CFrame.Position).Unit * 5000, rp)
                        if ray and not ray.Instance:IsDescendantOf(npc) then continue end
                    end
                    shortest = dist
                    closest = npc
                end
            end
        end
    end
    return closest
end

