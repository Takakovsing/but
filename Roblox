local function criarSwitch(parent)
    local switch = Instance.new("TextButton")
    switch.Size = UDim2.new(0, 56, 0, 28)
    switch.BackgroundColor3 = Color3.fromRGB(20, 20, 23)
    switch.BorderSizePixel = 0
    switch.Text = ""
    switch.AutoButtonColor = false
    switch.ZIndex = 20
    switch.Parent = parent

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = switch

    local border = Instance.new("UIStroke")
    border.Color = Color3.fromRGB(100, 100, 105)
    border.Thickness = 1.2
    border.Transparency = 0.25
    border.Parent = switch

    local onText = Instance.new("TextLabel")
    onText.Size = UDim2.new(0, 25, 1, 0)
    onText.Position = UDim2.new(0, 2, 0, 0)
    onText.BackgroundTransparency = 1
    onText.Text = "ON"
    onText.Font = Enum.Font.GothamBold
    onText.TextSize = 8
    onText.TextColor3 = RED
    onText.TextTransparency = 1
    onText.ZIndex = 21
    onText.Parent = switch

    local offText = Instance.new("TextLabel")
    offText.Size = UDim2.new(0, 27, 1, 0)
    offText.Position = UDim2.new(0, 29, 0, 0)
    offText.BackgroundTransparency = 1
    offText.Text = "OFF"
    offText.Font = Enum.Font.GothamBold
    offText.TextSize = 8
    offText.TextColor3 = Color3.fromRGB(145, 145, 150)
    offText.ZIndex = 21
    offText.Parent = switch

    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, 22, 0, 22)
    knob.Position = UDim2.new(0, 3, 0.5, -11)
    knob.BackgroundColor3 = Color3.fromRGB(180, 180, 185)
    knob.BorderSizePixel = 0
    knob.ZIndex = 22
    knob.Parent = switch

    local knobCorner = Instance.new("UICorner")
    knobCorner.CornerRadius = UDim.new(0, 6)
    knobCorner.Parent = knob

    local knobStroke = Instance.new("UIStroke")
    knobStroke.Color = Color3.fromRGB(255, 255, 255)
    knobStroke.Thickness = 1
    knobStroke.Transparency = 0.65
    knobStroke.Parent = knob

    local ligado = false
    local callbacks = {}
    local api = {}

    registerTheme(function(c)
        onText.TextColor3 = c
        if ligado then
            switch.BackgroundColor3 = darken(c, 0.2)
            border.Color = c
            border.Transparency = 0
        end
    end)

    function api.getState() return ligado end
    function api.onToggle(fn) table.insert(callbacks, fn) end

    function api.setVisual(v)
        ligado = v
        if ligado then
            switch.BackgroundColor3 = darken(RED, 0.2)
            border.Color = RED
            border.Transparency = 0
            knob.Position = UDim2.new(1, -25, 0.5, -11)
            knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            onText.TextTransparency = 0
            offText.TextTransparency = 1
        else
            switch.BackgroundColor3 = Color3.fromRGB(20, 20, 23)
            border.Color = Color3.fromRGB(100, 100, 105)
            border.Transparency = 0.25
            knob.Position = UDim2.new(0, 3, 0.5, -11)
            knob.BackgroundColor3 = Color3.fromRGB(180, 180, 185)
            onText.TextTransparency = 1
            offText.TextTransparency = 0
        end
    end

    switch.MouseButton1Click:Connect(function()
        ligado = not ligado
        local dark = darken(RED, 0.2)

        if ligado then
            TweenService:Create(switch, smallTween, {BackgroundColor3 = dark}):Play()
            TweenService:Create(border, smallTween, {Color = RED, Transparency = 0}):Play()
            TweenService:Create(knob, drawerTween, {Position = UDim2.new(1, -25, 0.5, -11), BackgroundColor3 = Color3.fromRGB(255, 255, 255)}):Play()
            TweenService:Create(onText, smallTween, {TextTransparency = 0}):Play()
            TweenService:Create(offText, smallTween, {TextTransparency = 1}):Play()
        else
            TweenService:Create(switch, smallTween, {BackgroundColor3 = Color3.fromRGB(20, 20, 23)}):Play()
            TweenService:Create(border, smallTween, {Color = Color3.fromRGB(100, 100, 105), Transparency = 0.25}):Play()
            TweenService:Create(knob, drawerTween, {Position = UDim2.new(0, 3, 0.5, -11), BackgroundColor3 = Color3.fromRGB(180, 180, 185)}):Play()
            TweenService:Create(onText, smallTween, {TextTransparency = 1}):Play()
            TweenService:Create(offText, smallTween, {TextTransparency = 0}):Play()
        end

        for _, fn in ipairs(callbacks) do
            pcall(fn, ligado)
        end
    end)

    api.frame = switch
    return api
end

