local function fecharGaveta(data)
    if not data.aberta then return end
    data.aberta = false

    TweenService:Create(data.arrow, drawerTween, {Rotation = 0}):Play()
    TweenService:Create(data.stroke, drawerTween, {Transparency = 0.4}):Play()

    local ct = TweenService:Create(data.children, drawerTween, {Size = UDim2.new(1, 0, 0, 0)})
    ct:Play()
    ct.Completed:Connect(function()
        if data.aberta then return end
        data.children.Visible = false
        TweenService:Create(data.drawer, drawerTween, {
            Size = UDim2.new(1, 0, 0, HEADER_HEIGHT)
        }):Play()
    end)
end

local function abrirGaveta(data)
    if data.aberta then return end
    data.aberta = true

    TweenService:Create(data.drawer, drawerTween, {
        Size = UDim2.new(1, 0, 0, data.openHeight)
    }):Play()

    data.children.Visible = true
    data.children.Size = UDim2.new(1, 0, 0, 0)

    TweenService:Create(data.arrow, drawerTween, {Rotation = 90}):Play()
    TweenService:Create(data.stroke, drawerTween, {Transparency = 0.08}):Play()
    TweenService:Create(data.children, drawerTween, {
        Size = UDim2.new(1, 0, 0, data.childrenHeight)
    }):Play()
end

local function criarGaveta(numero, nome, botoes, customHeight, customFill, afterCreate)
    local buttonCount = #botoes

    local childrenHeight
    if customHeight then
        childrenHeight = customHeight
    else
        childrenHeight = (BUTTON_HEIGHT * buttonCount) + (BUTTON_GAP * math.max(buttonCount - 1, 0))
    end

    local openHeight = HEADER_HEIGHT + CHILDREN_OFFSET + childrenHeight

    local drawer = Instance.new("Frame")
    drawer.Size = UDim2.new(1, 0, 0, HEADER_HEIGHT)
    drawer.BackgroundTransparency = 1
    drawer.BorderSizePixel = 0
    drawer.LayoutOrder = numero
    drawer.ZIndex = 5
    drawer.Parent = container

    local header = Instance.new("TextButton")
    header.Size = UDim2.new(1, 0, 0, HEADER_HEIGHT)
    header.BackgroundColor3 = Color3.fromRGB(9, 9, 11)
    header.BackgroundTransparency = 0.03
    header.BorderSizePixel = 0
    header.Text = ""
    header.AutoButtonColor = false
    header.ZIndex = 10
    header.Parent = drawer

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 9)
    corner.Parent = header

    local stroke = Instance.new("UIStroke")
    stroke.Color = RED
    stroke.Thickness = 1.2
    stroke.Transparency = 0.4
    stroke.Parent = header

    local accent = Instance.new("Frame")
    accent.Size = UDim2.new(0, 3, 0.55, 0)
    accent.Position = UDim2.new(0, 8, 0.225, 0)
    accent.BackgroundColor3 = RED
    accent.BorderSizePixel = 0
    accent.ZIndex = 11
    accent.Parent = header

    local accentCorner = Instance.new("UICorner")
    accentCorner.CornerRadius = UDim.new(0, 2)
    accentCorner.Parent = accent

    local text = Instance.new("TextLabel")
    text.Size = UDim2.new(1, -70, 1, 0)
    text.Position = UDim2.new(0, 25, 0, 0)
    text.BackgroundTransparency = 1
    text.Text = nome
    text.Font = Enum.Font.Arcade
    text.TextSize = 11
    text.TextColor3 = Color3.fromRGB(240, 240, 240)
    text.TextXAlignment = Enum.TextXAlignment.Left
    text.ZIndex = 11
    text.Parent = header

    local arrow = Instance.new("TextLabel")
    arrow.Size = UDim2.new(0, 30, 1, 0)
    arrow.Position = UDim2.new(1, -38, 0, 0)
    arrow.BackgroundTransparency = 1
    arrow.Text = "›"
    arrow.Font = Enum.Font.GothamBold
    arrow.TextSize = 22
    arrow.TextColor3 = RED
    arrow.ZIndex = 11
    arrow.Parent = header

    registerTheme(function(c)
        stroke.Color = c
        accent.BackgroundColor3 = c
        arrow.TextColor3 = c
    end)

    local children = Instance.new("Frame")
    children.Size = UDim2.new(1, 0, 0, 0)
    children.Position = UDim2.new(0, 0, 0, HEADER_HEIGHT + CHILDREN_OFFSET)
    children.BackgroundTransparency = 1
    children.Visible = false
    children.ClipsDescendants = true
    children.ZIndex = 6
    children.Parent = drawer

    if customFill then
        customFill(children)
    else
        local childLayout = Instance.new("UIListLayout")
        childLayout.Padding = UDim.new(0, BUTTON_GAP)
        childLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
        childLayout.SortOrder = Enum.SortOrder.LayoutOrder
        childLayout.Parent = children

        for ordem, cfg in ipairs(botoes) do
            local api
            if cfg.tipo == "switch" then
                api = criarSwitchButton(children, cfg.nome, ordem)
            elseif cfg.tipo == "cycler" then
