    PURPLE = Color3.fromRGB(170, 0, 255),
    YELLOW = Color3.fromRGB(255, 200, 0),
    PINK   = Color3.fromRGB(255, 0, 170),
    CYAN   = Color3.fromRGB(0, 220, 255),
    ORANGE = Color3.fromRGB(255, 100, 0),
    WHITE  = Color3.fromRGB(240, 240, 240),
}
local THEME_ORDER = {"RED","BLUE","GREEN","PURPLE","YELLOW","PINK","CYAN","ORANGE","WHITE"}

local themeIndex = 1
local RED = THEME_PRESETS.RED
local BLACK = Color3.fromRGB(5, 5, 7)

local function darken(color, factor)
    return Color3.new(color.R * factor, color.G * factor, color.B * factor)
end

local themeRegistry = {}
local function registerTheme(fn)
    table.insert(themeRegistry, fn)
    local ok, err = pcall(fn, RED)
    if not ok then warn("[Portuga] theme err: " .. tostring(err)) end
end
local function applyTheme(newColor)
    RED = newColor
    for _, fn in ipairs(themeRegistry) do
        local ok, err = pcall(fn, newColor)
        if not ok then warn("[Portuga] applyTheme err: " .. tostring(err)) end
    end
end

