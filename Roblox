    for _, p in pairs(Players:GetPlayers()) do
        if p ~= Player and p.Character then
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            local hum = p.Character:FindFirstChild("Humanoid")
            if hrp and hum then
                if hum.Health <= 0 then continue end
                if teamCheck and p.Team == Player.Team then continue end
                if teamMiscEnabled and selectedTeam then
                    if p.Team ~= selectedTeam then continue end
                end
                local dir = (hrp.Position - Camera.CFrame.Position).Unit
                if camLook:Dot(dir) < 0 then behindCount += 1 end
            end
        end
    end

    if showBehindCount then
        behindText.Text = "BEHIND: " .. behindCount
    end

    for player, esp in pairs(ESPs) do
        local char = player.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChild("Humanoid")

        if espEnabled and hrp and hum then
            if hum.Health <= 0 then
                for _, v in pairs(esp) do v.Visible = false end
                continue
            end
            if teamCheck and player.Team == Player.Team then
                for _, v in pairs(esp) do v.Visible = false end
                continue
            end
            if teamMiscEnabled and selectedTeam then
                if player.Team ~= selectedTeam then
                    for _, v in pairs(esp) do v.Visible = false end
                    continue
                end
            end

            local pos, vis = Camera:WorldToViewportPoint(hrp.Position)
            if vis then
                local size = 60 / pos.Z
                esp[1].Size = Vector2.new(size * 2, size * 3)
                esp[1].Position = Vector2.new(pos.X - size, pos.Y - size)
                esp[1].Color = lineColor
                esp[1].Visible = true

                esp[2].From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                esp[2].To = Vector2.new(pos.X, pos.Y)
                esp[2].Color = lineColor
                esp[2].Visible = true

                local hpText = "[" .. math.floor(hum.Health) .. "]"
                if espNameEnabled then
                    esp[3].Text = player.Name .. " " .. hpText
                else
                    esp[3].Text = hpText
                end
                esp[3].Position = Vector2.new(pos.X, pos.Y - size * 1.8)
                esp[3].Color = lineColor
                esp[3].Visible = true
            else
                for _, v in pairs(esp) do v.Visible = false end
            end
        else
            for _, v in pairs(esp) do v.Visible = false end
        end
    end
end)

local function getTarget()
    local closest = nil
    local shortest = FOV

    if aimToolEnabled then
        local tool = Player.Character and Player.Character:FindFirstChildOfClass("Tool")
        if not tool then return nil end
    end

    for _, p in pairs(Players:GetPlayers()) do
        if p ~= Player and p.Character then
            local char = p.Character
            local hum = char:FindFirstChild("Humanoid")
            local part = char:FindFirstChild(aimPart)
            if not hum or not part then continue end
            if hum.Health <= 0 then continue end
            if teamCheck and p.Team == Player.Team then continue end
            if teamMiscEnabled and selectedTeam then
                if p.Team ~= selectedTeam then continue end
            end

            local pos, vis = Camera:WorldToViewportPoint(part.Position)
            if vis then
                local dist = (Vector2.new(pos.X, pos.Y) - Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)).Magnitude
                if dist < shortest then
                    if wallCheck then
                        local rp = RaycastParams.new()
                        rp.FilterType = Enum.RaycastFilterType.Blacklist
                        rp.FilterDescendantsInstances = {Player.Character}
                        local ray = workspace:Raycast(Camera.CFrame.Position, (part.Position - Camera.CFrame.Position).Unit * 5000, rp)
                        if ray and not ray.Instance:IsDescendantOf(char) then continue end
                    end
                    shortest = dist
                    closest = p
                end
            end
        end
    end
    return closest
end

