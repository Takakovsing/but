-- GAVETA SYSTEM
local function fecharGaveta(data)
    if not data.aberta then return end
    data.aberta=false
    TS:Create(data.arrow,drawerTween,{Rotation=0}):Play()
    TS:Create(data.stroke,drawerTween,{Transparency=0.4}):Play()
    local ct=TS:Create(data.children,drawerTween,{Size=UDim2.new(1,0,0,0)})
    ct:Play()
    ct.Completed:Connect(function()
        if data.aberta then return end
        data.children.Visible=false
        TS:Create(data.drawer,drawerTween,{Size=UDim2.new(1,0,0,HEADER_HEIGHT)}):Play()
    end)
end

local function abrirGaveta(data)
    if data.aberta then return end
    data.aberta=true
    TS:Create(data.drawer,drawerTween,{Size=UDim2.new(1,0,0,data.openHeight)}):Play()
    data.children.Visible=true
    data.children.Size=UDim2.new(1,0,0,0)
    TS:Create(data.arrow,drawerTween,{Rotation=90}):Play()
    TS:Create(data.stroke,drawerTween,{Transparency=0.08}):Play()
    TS:Create(data.children,drawerTween,{Size=UDim2.new(1,0,0,data.childrenHeight)}):Play()
end

local function criarGaveta(numero,nome,botoes,customHeight,customFill,afterCreate)
    local buttonCount=#botoes
    local childrenHeight
    if customHeight then childrenHeight=customHeight
    else childrenHeight=(BUTTON_HEIGHT*buttonCount)+(BUTTON_GAP*math.max(buttonCount-1,0)) end
    local openHeight=HEADER_HEIGHT+CHILDREN_OFFSET+childrenHeight
    local drawer=Instance.new("Frame",container)
    drawer.Size=UDim2.new(1,0,0,HEADER_HEIGHT)
    drawer.BackgroundTransparency=1
    drawer.BorderSizePixel=0
    drawer.LayoutOrder=numero
    drawer.ZIndex=5
    local header=Instance.new("TextButton",drawer)
    header.Size=UDim2.new(1,0,0,HEADER_HEIGHT)
    header.BackgroundColor3=Color3.fromRGB(9,9,11)
    header.BackgroundTransparency=0.03
    header.BorderSizePixel=0
    header.Text=""
    header.AutoButtonColor=false
    header.ZIndex=10
    Instance.new("UICorner",header).CornerRadius=UDim.new(0,9)
    local stroke=Instance.new("UIStroke",header)
    stroke.Color=RED
    stroke.Thickness=1.2
    stroke.Transparency=0.4
    local accent=Instance.new("Frame",header)
    accent.Size=UDim2.new(0,3,0.55,0)
    accent.Position=UDim2.new(0,8,0.225,0)
    accent.BackgroundColor3=RED
    accent.BorderSizePixel=0
    accent.ZIndex=11
    Instance.new("UICorner",accent).CornerRadius=UDim.new(0,2)
    local text=Instance.new("TextLabel",header)
    text.Size=UDim2.new(1,-70,1,0)
    text.Position=UDim2.new(0,25,0,0)
    text.BackgroundTransparency=1
    text.Text=nome
    text.Font=Enum.Font.Arcade
    text.TextSize=11
    text.TextColor3=Color3.fromRGB(240,240,240)
    text.TextXAlignment=Enum.TextXAlignment.Left
    text.ZIndex=11
    local arrow=Instance.new("TextLabel",header)
    arrow.Size=UDim2.new(0,30,1,0)
    arrow.Position=UDim2.new(1,-38,0,0)
    arrow.BackgroundTransparency=1
    arrow.Text="›"
    arrow.Font=Enum.Font.GothamBold
    arrow.TextSize=22
    arrow.TextColor3=RED
    arrow.ZIndex=11
    registerTheme(function(c) stroke.Color=c; accent.BackgroundColor3=c; arrow.TextColor3=c end)
    local children=Instance.new("Frame",drawer)
    children.Size=UDim2.new(1,0,0,0)
    children.Position=UDim2.new(0,0,0,HEADER_HEIGHT+CHILDREN_OFFSET)
    children.BackgroundTransparency=1
    children.Visible=false
    children.ClipsDescendants=true
    children.ZIndex=6
    if customFill then customFill(children)
    else
        local childLayout=Instance.new("UIListLayout",children)
        childLayout.Padding=UDim.new(0,BUTTON_GAP)
        childLayout.HorizontalAlignment=Enum.HorizontalAlignment.Center
        childLayout.SortOrder=Enum.SortOrder.LayoutOrder
        for ordem,cfg in ipairs(botoes) do
            local api
            if cfg.tipo=="switch" then api=criarSwitchButton(children,cfg.nome,ordem)
            elseif cfg.tipo=="cycler" then api=criarCyclerButton(children,cfg.nome,cfg.valor,ordem)
            elseif cfg.tipo=="action" then api=criarActionButton(children,cfg.nome,ordem)
            elseif cfg.tipo=="textbox" then api=criarTextBoxButton(children,cfg.nome,cfg.valor,ordem) end
            if cfg.key and api then UI[cfg.key]=api end
        end
    end
    local data={drawer=drawer,children=children,arrow=arrow,stroke=stroke,aberta=false,childrenHeight=childrenHeight,openHeight=openHeight}
    table.insert(gavetas,data)
    header.MouseButton1Click:Connect(function() if data.aberta then fecharGaveta(data) else abrirGaveta(data) end end)
    header.MouseEnter:Connect(function() TS:Create(header,smallTween,{BackgroundColor3=darken(RED,0.2)}):Play(); TS:Create(stroke,smallTween,{Transparency=0.08}):Play() end)
    header.MouseLeave:Connect(function() TS:Create(header,smallTween,{BackgroundColor3=Color3.fromRGB(9,9,11)}):Play(); if data.aberta then TS:Create(stroke,smallTween,{Transparency=0.08}):Play() else TS:Create(stroke,smallTween,{Transparency=0.4}):Play() end end)
    if afterCreate then afterCreate(data) end
    return data
end

