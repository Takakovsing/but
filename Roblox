local NPC={}
local function isN(m)
    if not m or not m:IsA("Model") then return false end
    if PS:GetPlayerFromCharacter(m) then return false end
    if not m:FindFirstChildOfClass("Humanoid") then return false end
    if not m:FindFirstChild("HumanoidRootPart") then return false end
    return true
end
task.spawn(function()
    while true do
        local l={}
        for _,o in pairs(workspace:GetDescendants()) do
            if o:IsA("Model") and isN(o) then table.insert(l,o) end
        end
        NPC=l
        task.wait(1)
    end
end)

local function gNN(pn)
    local cl,sh=nil,FOV
    for _,n in pairs(NPC) do
        local h=n:FindFirstChildOfClass("Humanoid")
        local p=n:FindFirstChild(pn)
        if h and p and h.Health>0 then
            local ps,v=CAM:WorldToViewportPoint(p.Position)
            if v then
                local d=(Vector2.new(ps.X,ps.Y)-Vector2.new(CAM.ViewportSize.X/2,CAM.ViewportSize.Y/2)).Magnitude
                if d<sh then
                    if wallCheck then
                        local rp=RaycastParams.new()
                        rp.FilterType=Enum.RaycastFilterType.Blacklist
                        rp.FilterDescendantsInstances={PL.Character}
                        local r=workspace:Raycast(CAM.CFrame.Position,(p.Position-CAM.CFrame.Position).Unit*5000,rp)
                        if r and not r.Instance:IsDescendantOf(n) then continue end
                    end
                    sh=d
                    cl=n
                end
            end
        end
    end
    return cl
end

