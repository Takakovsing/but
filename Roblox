-- AIMBOT
--==================================================

local function getTarget()
    local closest = nil
    local shortest = FOV

    if aimToolEnabled then
        local char = Player.Character
        local tool = char and char:FindFirstChildOfClass("Tool")
        if not tool then return nil end
    end

    for _, p in pairs(Players:GetPlayers()) do
        if p ~= Player and p.Character then

            local char = p.Character
            local hum = char:FindFirstChild("Humanoid")
            local part = char:FindFirstChild(aimPart)

            if not hum or not part then continue end
            if hum.Health <= 0 then continue end
            if teamCheck and p.Team == Player.Team then continue end

            if teamMiscEnabled and selectedTeam then
                if p.Team ~= selectedTeam then continue end
            end

            local pos, vis = Camera:WorldToViewportPoint(part.Position)

            if vis then
                local dist = (Vector2.new(pos.X, pos.Y) - Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)).Magnitude

                if dist < shortest then

                    if wallCheck then
                        local rayParams = RaycastParams.new()
                        rayParams.FilterType = Enum.RaycastFilterType.Blacklist
                        rayParams.FilterDescendantsInstances = {Player.Character}

                        local ray = workspace:Raycast(Camera.CFrame.Position, (part.Position - Camera.CFrame.Position).Unit * 5000, rayParams)

                        if ray and not ray.Instance:IsDescendantOf(char) then
                            continue
                        end
                    end

                    shortest = dist
                    closest = p
                end
            end
        end
    end

    return closest
end

RunService.RenderStepped:Connect(function()
    if aimbotEnabled then
        local target = getTarget()

        if target and target.Character then
            local part = target.Character:FindFirstChild(aimPart)
            if part then
                Camera.CFrame = CFrame.new(Camera.CFrame.Position, part.Position)
            end
        end

        -- RAMPAGE
        if rampageEnabled then
            if target ~= rampageLastTarget then

                if lastDiedConn then
                    lastDiedConn:Disconnect()
                    lastDiedConn = nil
                end

                rampageLastTarget = target

                if target and target.Character then
                    local hum = target.Character:FindFirstChildOfClass("Humanoid")
                    if hum then
                        lastDiedConn = hum.Died:Connect(function()
                            if rampageEnabled then
                                killCount += 1
                                updateRampageText()
                            end
                        end)
                    end
                end
            end
        end

    else
        if lastDiedConn then
            lastDiedConn:Disconnect()
            lastDiedConn = nil
        end
        rampageLastTarget = nil
    end
end)
