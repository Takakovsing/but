local function readIndex()
    if not isfile(INDEX_FILE) then return{} end
    local o,d=pcall(function() return HS:JSONDecode(readfile(INDEX_FILE)) end)
    if o and type(d)=="table" then return d end
    return{}
end
local function writeIndex(l) pcall(function() writefile(INDEX_FILE,HS:JSONEncode(l)) end) end
local function indexAdd(n)
    local l=readIndex()
    for _,x in ipairs(l) do if x==n then return end end
    table.insert(l,n)
    table.sort(l)
    writeIndex(l)
end
local function indexRemove(n)
    local l=readIndex()
    for i,x in ipairs(l) do if x==n then table.remove(l,i); break end end
    writeIndex(l)
end
local function getSaveList()
    local l=readIndex()
    local v={}
    for _,n in ipairs(l) do
        local p=SAVE_PREFIX..n..SAVE_EXT
        if isfile(p) then table.insert(v,n) end
    end
    if #v~=#l then writeIndex(v) end
    return v
end

