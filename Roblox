local function criarTextBox(parent, valorInicial)
    local box = Instance.new("TextButton")
    box.Size = UDim2.new(0, 70, 0, 28)
    box.BackgroundColor3 = Color3.fromRGB(20, 20, 23)
    box.BorderSizePixel = 0
    box.Text = ""
    box.AutoButtonColor = false
    box.ZIndex = 20
    box.Parent = parent

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = box

    local border = Instance.new("UIStroke")
    border.Color = Color3.fromRGB(100, 100, 105)
    border.Thickness = 1.2
    border.Transparency = 0.25
    border.Parent = box

    local input = Instance.new("TextBox")
    input.Size = UDim2.new(1, -8, 1, -4)
    input.Position = UDim2.new(0, 4, 0, 2)
    input.BackgroundTransparency = 1
    input.Text = tostring(valorInicial)
    input.Font = Enum.Font.GothamBold
    input.TextSize = 10
    input.TextColor3 = Color3.fromRGB(240, 240, 240)
    input.PlaceholderText = "..."
    input.PlaceholderColor3 = Color3.fromRGB(120, 120, 125)
    input.TextXAlignment = Enum.TextXAlignment.Center
    input.ClearTextOnFocus = false
    input.ZIndex = 22
    input.Parent = box

    local focused = false

    registerTheme(function(c)
        border.Color = c
        if focused then
            box.BackgroundColor3 = darken(c, 0.15)
        end
    end)

    local api = {}
    function api.setValue(v) input.Text = tostring(v) end
    function api.getValue() return tonumber(input.Text) or 0 end
    function api.onSubmit(fn)
        input.FocusLost:Connect(function()
            fn(tonumber(input.Text) or 0)
        end)
    end

    input.Focused:Connect(function()
        focused = true
        TweenService:Create(border, smallTween, {Transparency = 0, Color = RED}):Play()
        TweenService:Create(box, smallTween, {BackgroundColor3 = darken(RED, 0.15)}):Play()
    end)

    input.FocusLost:Connect(function()
        focused = false
        TweenService:Create(border, smallTween, {Transparency = 0.25, Color = Color3.fromRGB(100, 100, 105)}):Play()
        TweenService:Create(box, smallTween, {BackgroundColor3 = Color3.fromRGB(20, 20, 23)}):Play()
    end)

    api.frame = box
    api.input = input
    return api
end

