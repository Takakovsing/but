// ==============================
// PROTEGER A CAIXA PGText
// CONTRA LISTENERS DA PÁGINA
// ==============================

const pgText=$("pgText");


// PASTE
pgText.addEventListener(
    "paste",
    event=>{

        event.stopImmediatePropagation();

    },
    true
