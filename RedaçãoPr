// ==============================
// ESCONDER / MOSTRAR
// ==============================

function toggleHiddenMode(){

    altHidden=!altHidden;


    if(altHidden){

        // Pausa a digitação
        if(typing){

            typingPaused=true;
        }


        // Esconde GUI
        gui.style.display="none";

        toggle.style.display="none";

        notifyBox.style.display="none";


        // DESINVERTE A PÁGINA INTEIRA
        document.body.style.filter="none";

    }else{

        // Mostra GUI
        gui.style.display="";

        toggle.style.display="";

        notifyBox.style.display="";


        // INVERTE NOVAMENTE A PÁGINA
        document.body.style.filter=
            "invert(1) hue-rotate(180deg)";


        // Continua a digitação
        if(typing){

            typingPaused=false;
        }
    }
}


// ==============================
// ATALHOS
// ==============================

document.addEventListener(
    "keydown",
    event=>{

        // ESC
        if(event.key==="Escape"){

            minimized=!minimized;

            gui.classList.toggle(
                "pgMini",
                minimized
            );

            return;
        }


        // CTRL
        if(event.key==="Control"){

            if(typing){

                typingPaused=
                    !typingPaused;

                if(typingPaused){

                    notifyBox.textContent=
                        "Digitação pausada";

                }else{

                    notifyBox.textContent=
                        "Digitação continuando";
                }

                if(!altHidden){

                    notify();
                }
            }

            return;
        }


        // ALT
        if(event.key==="Alt"){

            toggleHiddenMode();

            return;
        }
    }
);


// ==============================
// CLIQUE NO SCROLL
// BOTÃO CENTRAL
// ==============================

document.addEventListener(
    "mousedown",
    event=>{

        // 0 = esquerdo
        // 1 = scroll / botão central
        // 2 = direito

        if(event.button!==1)
            return;


        // Impede o autoscroll
        event.preventDefault();


        // Faz exatamente o mesmo
        // que o ALT
        toggleHiddenMode();
    }
);


