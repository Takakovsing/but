toggle.onclick=()=>{

    if(
        toggle.dataset.dragged===
        "true"
    ){

        toggle.dataset.dragged=
            "false";

        return;
    }

    minimized=!minimized;

    gui.classList.toggle(
        "pgMini",
        minimized
    );
};


// ==============================
// ARRASTAR BOTÃO
// ==============================

let toggleDragging=false;
let toggleMoved=false;

let toggleOffsetX=0;
let toggleOffsetY=0;


toggle.addEventListener(
    "mousedown",
    event=>{

        toggleDragging=true;
        toggleMoved=false;

        toggleOffsetX=
            event.clientX-
            toggle.offsetLeft;

        toggleOffsetY=
            event.clientY-
            toggle.offsetTop;

        event.preventDefault();
    }
);


document.addEventListener(
    "mousemove",
    event=>{

        if(!toggleDragging)return;

        toggleMoved=true;

        toggle.style.left=
            event.clientX-
            toggleOffsetX+
            "px";

        toggle.style.top=
            event.clientY-
            toggleOffsetY+
            "px";

        toggle.style.right="auto";
        toggle.style.bottom="auto";
    }
);


document.addEventListener(
    "mouseup",
    ()=>{

        if(!toggleDragging)return;

        if(toggleMoved){

            toggle.dataset.dragged=
                "true";
        }

        toggleDragging=false;
    }
);


// ==============================
// ARRASTAR BOTÃO NO CELULAR
// ==============================

toggle.addEventListener(
    "touchstart",
    event=>{

        const touch=
            event.touches[0];

        toggleDragging=true;
        toggleMoved=false;

        toggleOffsetX=
            touch.clientX-
            toggle.offsetLeft;

        toggleOffsetY=
            touch.clientY-
            toggle.offsetTop;

    },
    {passive:true}
);


document.addEventListener(
    "touchmove",
    event=>{

        if(!toggleDragging)return;

        const touch=
            event.touches[0];

        toggleMoved=true;

        toggle.style.left=
            touch.clientX-
            toggleOffsetX+
            "px";

        toggle.style.top=
            touch.clientY-
            toggleOffsetY+
            "px";

        toggle.style.right="auto";
        toggle.style.bottom="auto";

    },
    {passive:true}
);


document.addEventListener(
    "touchend",
    ()=>{

        if(!toggleDragging)return;

        if(toggleMoved){

            toggle.dataset.dragged=
                "true";
        }

        toggleDragging=false;
    }
);


