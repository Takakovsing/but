// ==============================
// NOTIFY
// ==============================

function notify(){

    if(altHidden)return;

    notifyBox.style.opacity="1";

    notifyBox.style.transform=
        "translateX(-50%) translateY(0)";

    setTimeout(()=>{

        notifyBox.style.opacity="0";

        notifyBox.style.transform=
            "translateX(-50%) translateY(-20px)";

    },1800);
}


// ==============================
// FORÇAR CÓPIA
// ==============================

$("pgCopy").onclick=async()=>{

    const selected=
        window.getSelection().toString();

    if(!selected){

        alert(
            "Selecione algum texto primeiro!"
        );

        return;
    }

    try{

        await navigator.clipboard.writeText(
            selected
        );

    }catch(e){

        const temp=
            document.createElement("textarea");

        temp.value=selected;

        document.body.appendChild(temp);

        temp.select();

        document.execCommand("copy");

        temp.remove();
    }

    notify();
};


// ==============================
// DIGITAR TEXTO
// ==============================

$("pgType").onclick=async()=>{

    const text=
        pgText.value;

    if(!text){

        alert(
            "Digite algum texto primeiro!"
        );

        return;
    }

    const field=
        document.querySelector(
            'textarea:not(#pgText)'
        );

    if(!field){

        alert(
            "Nenhuma caixa de texto foi encontrada!"
        );

        return;
    }

    typing=true;
    typingPaused=false;

    field.focus();

    for(const char of text){

        while(
            typingPaused &&
            typing
        ){

            await new Promise(
                resolve=>
                    setTimeout(
                        resolve,
                        50
                    )
            );
        }

        if(!typing){

            return;
        }


        field.setRangeText(
            char,
            field.selectionStart,
            field.selectionEnd,
            "end"
        );


        field.dispatchEvent(
            new KeyboardEvent(
                "keydown",
                {
                    key:char,
                    bubbles:true
                }
            )
        );


        field.dispatchEvent(
            new InputEvent(
                "input",
                {
                    bubbles:true,
                    data:char,
                    inputType:"insertText"
                }
            )
        );


        field.dispatchEvent(
            new KeyboardEvent(
                "keyup",
                {
                    key:char,
                    bubbles:true
                }
            )
        );


        await new Promise(
            resolve=>
                setTimeout(
                    resolve,
                    20
                )
        );
    }

    typing=false;

    notify();
};


