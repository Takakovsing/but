// ==============================
// ESCONDER / MOSTRAR
// ==============================

function toggleHiddenMode(){

    altHidden=!altHidden;

    if(altHidden){

        if(typing){

            typingPaused=true;

        }

        gui.style.display="none";

        toggle.style.display="none";

        notifyBox.style.display="none";


        // PÁGINA NORMAL
        document.body.style.filter="none";

    }else{

        gui.style.display="";

        toggle.style.display="";

        notifyBox.style.display="";


        // PÁGINA INVERTIDA
        document.body.style.filter=
            "invert(1) hue-rotate(180deg)";


        if(typing){

            typingPaused=false;

        }
    }
}


// ==============================
// ATALHOS
// ==============================

document.addEventListener(
    "keydown",
    event=>{

        // ESC
        if(event.key==="Escape"){

            minimized=!minimized;

            gui.classList.toggle(
                "pgMini",
                minimized
            );

            return;
        }


        // CTRL
        if(event.key==="Control"){

            if(typing){

                typingPaused=
                    !typingPaused;

                notifyBox.textContent=
                    typingPaused
                    ? "Digitação pausada"
                    : "Digitação continuando";

                notify();

            }

            return;
        }


        // ALT
        if(event.key==="Alt"){

            toggleHiddenMode();

            return;
        }

    }
);


// ==============================
// SCROLL / BOTÃO DO MEIO
// ==============================

document.addEventListener(
    "mousedown",
    event=>{

        // 1 = botão central / scroll
        if(event.button!==1)return;

        event.preventDefault();

        toggleHiddenMode();

    }
);


})();
