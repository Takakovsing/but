    /* ============================================================
       EXTRAÇÃO DE LETRA — CORRIGIDO
       Só aceita:
         - "B" (letra isolada)
         - "B) ..." / "B. ..." / "B - ..." / "B: ..." (letra + separador + texto)
       NUNCA aceita "Bolo" como letra "B".
    ============================================================ */

    function extractLetter(v) {
        const s = clean(v);
        if (!s) return null;

        // Letra isolada
        if (/^[a-eA-E]$/.test(s)) {
            return { letter: s.toLowerCase(), rest: "" };
        }
        // Letra + separador + resto
        const m = s.match(/^([a-eA-E])\s*[\.\)\-:]\s*(.*)$/);
        if (m) {
            return { letter: m[1].toLowerCase(), rest: (m[2] || "").trim() };
        }
        return null;
    }

    /* ============================================================
       NORMALIZAÇÃO — mantém semântica de "texto puro sem letra"
    ============================================================ */

    function stripLetterPrefix(v) {
        const s = clean(v);
        const m = s.match(/^([a-eA-E])\s*[\.\)\-:]\s*(.*)$/);
        if (m) return (m[2] || "").trim();
        return s;
    }

    function normalizeForMatch(v) {
        return stripLetterPrefix(v)
            .toLowerCase()
            .replace(/[“”"']/g, "")
            .replace(/\s+/g, " ")
            .trim();
    }

    /* ============================================================
       DETECÇÃO DE DROPDOWNS
    ============================================================ */

    function isSelectAnswerText(t) {
        return /^\s*selecione(\s+a\s+resposta)?\s*$/i.test(t) ||
               /^\s*select\s*(an?\s*answer|a\s*resposta)?\s*$/i.test(t) ||
               /^\s*escolha(\s+a\s+resposta)?\s*$/i.test(t);
    }

    function getDropdowns() {
        const results = [];
        const seen = new Set();

        document.querySelectorAll("select").forEach(el => {
            if (!isVisible(el) || seen.has(el)) return;
            if (el.closest("#pgFloat")) return;
            seen.add(el);
            results.push(el);
        });

        const semantic = [
            '[role="combobox"]',
            '[aria-haspopup="listbox"]',
            "button.options-dropdown",
            '[data-cy*="dropdown"] button'
        ].flatMap(sel => {
            try { return [...document.querySelectorAll(sel)]; }
            catch { return []; }
        });

        semantic.forEach(el => {
            if (!isVisible(el) || seen.has(el)) return;
            if (el.closest("#pgFloat")) return;
            const text = clean(el.innerText || el.textContent);
            const hasListbox = el.getAttribute("aria-haspopup") === "listbox";
            const hasCombo = el.getAttribute("role") === "combobox";
            const looksSelect = isSelectAnswerText(text) || /selecione|select|escolha/i.test(text);
            if (!hasListbox && !hasCombo && !looksSelect) return;
            seen.add(el);
            results.push(el);
        });

        return results;
    }

    /* ============================================================
       DETECÇÃO DE OPÇÕES CLICÁVEIS (assinalar) — REESCRITA
       Ordem de prioridade: pára no primeiro seletor que devolver ≥2.
       Deduplica por texto normalizado. Ordena por posição no DOM.
    ============================================================ */

    function getAnswerChoiceElements() {
        const selectors = [
            '[data-cy*="option"]',
            '[data-cy*="answer"]',
            '[role="radio"]',
            '[role="checkbox"]',
            'button[aria-checked]',
            '[class*="AnswerOption"]',
            '[class*="answer-option"]',
            '[class*="option"][role="button"]'
        ];

        for (const sel of selectors) {
            let list;
            try { list = document.querySelectorAll(sel); }
            catch { continue; }

            const items = [];
            const seen = new Set();
            for (const el of list) {
                if (!isVisible(el) || seen.has(el)) continue;
                if (el.closest("#pgFloat")) continue;
                const text = clean(el.innerText || el.textContent);
                if (!text || text.length > 500) continue;
                seen.add(el);
                items.push({ element: el, text });
            }
            if (items.length >= 2) {
                const deduped = dedupeChoices(items);
                if (deduped.length >= 2) return deduped;
            }
        }

        /* Fallback: botões/role=button com prefixo de letra A–E */
        const letterRe = /^\s*([a-eA-E])\s*[\.\)\-:]\s*(.+)$/;
        const buttons = [...document.querySelectorAll('button, [role="button"], [role="radio"], [role="checkbox"]')]
            .filter(b => {
                if (!isVisible(b)) return false;
                if (b.closest("#pgFloat")) return false;
                const t = clean(b.innerText || b.textContent);
                return t && t.length < 500 && letterRe.test(t);
            });

        const seen = new Set();
        const items = [];
        for (const b of buttons) {
            if (seen.has(b)) continue;
            seen.add(b);
            items.push({ element: b, text: clean(b.innerText || b.textContent) });
        }

        return dedupeChoices(items);
    }

    function dedupeChoices(items) {
        if (!items.length) return items;

        // Remove elementos que contêm outro item (wrappers/containers).
        // Se A contém B e ambos têm o mesmo texto normalizado,
        // mantemos apenas B (o mais interno).
        let filtered = items.filter(item => {
            return !items.some(other =>
                other !== item &&
                item.element.contains(other.element) &&
                normalizeForMatch(other.text) === normalizeForMatch(item.text)
            );
        });

        // Deduplica por texto normalizado (guarda o primeiro em ordem DOM).
        const byText = new Map();
        for (const it of filtered) {
            const k = normalizeForMatch(it.text) || it.text;
            if (!byText.has(k)) byText.set(k, it);
        }
        const out = [...byText.values()];

        // Ordena por posição no DOM.
        out.sort((a, b) => {
            const pos = a.element.compareDocumentPosition(b.element);
            if (pos & Node.DOCUMENT_POSITION_FOLLOWING) return -1;
            if (pos & Node.DOCUMENT_POSITION_PRECEDING) return 1;
            return 0;
        });

        return out;
    }

    /* MENU DE OPÇÕES (para dropdowns) */

    function getVisibleLeaves() {
        return [...document.querySelectorAll("body *")].filter(el => {
