javascript:(async()=>{

const KEY_CORRETA="rzinmodder";

const key=prompt("Digite a Key:");

if(key!==KEY_CORRETA){
    alert("Key inválida!");
    return;
}

if(document.getElementById("pgFloat"))return;

let minimized=false;
let hidden=false;
let pageText="";
let dragging=false;
let offsetX=0;
let offsetY=0;

const favicon=document.createElement("link");
favicon.rel="icon";
favicon.href="https://media.tenor.com/m11vauEEbcUAAAAM/meow-neko-arc.gif";
document.head.appendChild(favicon);

const style=document.createElement("style");

style.textContent=`

body{
    filter:invert(1) hue-rotate(180deg)!important;
    transition:filter .45s ease!important;
}

#pgFloat,#pgToggle,#pgNotify{
    filter:invert(1) hue-rotate(180deg)!important;
}

#pgFloat{
    position:fixed;
    top:80px;
    left:50%;
    width:320px;
    padding:16px;
    box-sizing:border-box;
    background:rgba(20,20,20,.78);
    backdrop-filter:blur(15px);
    -webkit-backdrop-filter:blur(15px);
    color:#eee;
    border:1px solid rgba(255,255,255,.18);
    border-radius:20px;
    z-index:2147483640;
    font-family:"Trebuchet MS",Arial,sans-serif;
    box-shadow:0 15px 50px #000b;
    user-select:none;
    transform:translateX(-50%) scale(1);
    transition:opacity .3s ease,
               transform .35s cubic-bezier(.2,.8,.2,1),
               visibility .35s ease;
}

#pgFloat.pgMini{
    opacity:0;
    visibility:hidden;
    transform:translateX(-50%) scale(.82);
}

#pgHead{
    height:32px;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:18px;
    font-weight:bold;
    letter-spacing:1px;
    cursor:move;
    margin-bottom:12px;
    touch-action:none;
}

#pgLine{
    height:1px;
    background:rgba(255,255,255,.2);
    margin-bottom:14px;
}

#pgQuestion,#pgAnswer{
    width:100%;
    box-sizing:border-box;
    background:rgba(0,0,0,.4);
    color:#eee;
    border:1px solid rgba(255,255,255,.18);
    border-radius:13px;
    padding:12px;
    outline:none;
    font-family:"Trebuchet MS",Arial,sans-serif;
    font-size:14px;
    user-select:text;
}

#pgQuestion{
    height:80px;
    resize:none;
}

#pgAnswer{
    height:150px;
    resize:none;
    margin-top:10px;
}

#pgQuestion:focus,#pgAnswer:focus{
    border-color:rgba(255,255,255,.5);
    box-shadow:0 0 15px rgba(255,255,255,.08);
}

#pgFloat button{
    width:100%;
    border:1px solid rgba(255,255,255,.12);
    border-radius:12px;
    padding:12px;
    margin-top:9px;
    background:rgba(255,255,255,.12);
    color:#eee;
    font-family:"Trebuchet MS",Arial,sans-serif;
    font-weight:bold;
    font-size:14px;
    cursor:pointer;
    transition:background .2s ease,
               transform .2s ease,
               box-shadow .2s ease;
}

#pgFloat button:hover{
    background:rgba(255,255,255,.2);
    transform:translateY(-2px);
    box-shadow:0 6px 18px #0005;
}

#pgFloat button:active{
    transform:scale(.97);
}

#pgToggle{
    position:fixed;
    right:20px;
    bottom:25px;
    width:62px;
    height:62px;
    border-radius:50%;
    background:#111;
    border:2px solid #555;
    z-index:2147483641;
    box-shadow:0 8px 30px #000b;
    cursor:pointer;
    overflow:hidden;
    display:flex;
    align-items:center;
    justify-content:center;
    transition:transform .3s cubic-bezier(.2,.8,.2,1),
               box-shadow .3s ease,
               border-color .3s ease;
    user-select:none;
    touch-action:none;
}

#pgToggle:hover{
    transform:scale(1.08);
    border-color:#aaa;
}

#pgToggle:active{
    transform:scale(.92);
}

#pgToggle img{
    width:100%;
    height:100%;
    object-fit:cover;
    pointer-events:none;
}

#pgNotify{
    position:fixed;
    top:25px;
    left:50%;
    transform:translateX(-50%) translateY(-20px);
    background:#555;
    color:#fff;
    padding:11px 25px;
    border-radius:10px;
    font-family:"Trebuchet MS",Arial,sans-serif;
    font-weight:bold;
    font-size:15px;
    z-index:2147483642;
    opacity:0;
    transition:opacity .3s ease,
               transform .35s ease;
    box-shadow:0 8px 25px #0008;
    pointer-events:none;
}

`;

document.head.appendChild(style);


// ==============================
// GUI
// ==============================

const gui=document.createElement("div");

gui.id="pgFloat";

gui.innerHTML=`

<div id="pgHead">
    PORTUGA IA
</div>

<div id="pgLine"></div>

<textarea
id="pgQuestion"
placeholder="Digite sua pergunta para a IA..."
></textarea>

<button id="pgRead">
    LER PÁGINA
</button>

<button id="pgAsk">
    PERGUNTAR À IA
</button>

<textarea
id="pgAnswer"
placeholder="A resposta da IA aparecerá aqui..."
readonly
></textarea>

`;

document.body.appendChild(gui);


// ==============================
// BOTÃO FLUTUANTE
// ==============================

const toggle=document.createElement("div");

toggle.id="pgToggle";

toggle.innerHTML=`

<img src="https://media.tenor.com/m11vauEEbcUAAAAM/meow-neko-arc.gif">

`;

document.body.appendChild(toggle);


// ==============================
// NOTIFICAÇÃO
// ==============================

const notifyBox=document.createElement("div");

notifyBox.id="pgNotify";
notifyBox.textContent="Feito!!";

document.body.appendChild(notifyBox);

const $=id=>document.getElementById(id);


// ==============================
// NOTIFICAÇÃO
// ==============================

function notify(text="Feito!!"){

    notifyBox.textContent=text;

    notifyBox.style.opacity="1";

    notifyBox.style.transform=
        "translateX(-50%) translateY(0)";

    setTimeout(()=>{

        notifyBox.style.opacity="0";

        notifyBox.style.transform=
            "translateX(-50%) translateY(-20px)";

    },1800);
}


// ==============================
// LER PÁGINA
// ==============================

$("pgRead").onclick=()=>{

    const clone=document.body.cloneNode(true);

    const remover=[
        "#pgFloat",
        "#pgToggle",
        "#pgNotify",
        "script",
        "style",
        "noscript"
    ];

    remover.forEach(seletor=>{

        clone.querySelectorAll(seletor)
            .forEach(e=>e.remove());

    });

    pageText=
        clone.innerText
        .replace(/\n{3,}/g,"\n\n")
        .trim();

    if(!pageText){

        alert(
            "Não encontrei texto na página!"
        );

        return;
    }

    // Limite para evitar enviar páginas gigantes
    pageText=pageText.slice(0,50000);

    notify(
        "Página lida!"
    );

};


// ==============================
// PERGUNTAR À IA
// ==============================

$("pgAsk").onclick=async()=>{

    const pergunta=
        $("pgQuestion").value.trim();

    if(!pergunta){

        alert(
            "Digite uma pergunta primeiro!"
        );

        return;
    }

    if(!pageText){

        alert(
            "Clique em LER PÁGINA primeiro!"
        );

        return;
    }


    // A chave NÃO fica salva no código
    const apiKey=
        prompt(
            "Cole sua chave do OpenRouter:"
        );

    if(!apiKey){

        return;
    }


    $("pgAsk").textContent=
        "CONSULTANDO IA...";

    $("pgAsk").disabled=true;

    $("pgAnswer").value=
        "Enviando conteúdo para a IA...";


    try{

        const resposta=
            await fetch(
                "https://openrouter.ai/api/v1/chat/completions",
                {
                    method:"POST",

                    headers:{
                        "Authorization":
                            "Bearer "+apiKey,

                        "Content-Type":
                            "application/json"
                    },

                    body:JSON.stringify({

                        model:
                            "openrouter/free",

                        messages:[

                            {
                                role:"system",

                                content:
                                    "Você é um assistente que analisa o conteúdo de páginas da internet. Responda em português, de forma clara e objetiva. Use o conteúdo fornecido para responder."
                            },

                            {
                                role:"user",

                                content:
                                    "PERGUNTA:\n"+
                                    pergunta+
                                    "\n\n"+
                                    "CONTEÚDO DA PÁGINA:\n"+
                                    pageText
                            }

                        ]

                    })

                }
            );


        const dados=
            await resposta.json();


        if(!resposta.ok){

            throw new Error(
                dados?.error?.message ||
                "Erro HTTP "+resposta.status
            );

        }


        const resultado=
            dados?.choices?.[0]?.message?.content;


        if(!resultado){

            throw new Error(
                "A IA não retornou uma resposta."
            );

        }


        $("pgAnswer").value=
            resultado;

        notify(
            "Resposta recebida!"
        );


    }catch(erro){

        $("pgAnswer").value=
            "ERRO:\n\n"+
            erro.message;

        alert(
            "Erro ao consultar a IA:\n\n"+
            erro.message
        );


    }finally{

        $("pgAsk").textContent=
            "PERGUNTAR À IA";

        $("pgAsk").disabled=false;

    }

};


// ==============================
// MINIMIZAR
// ==============================

toggle.onclick=()=>{

    if(toggle.dataset.dragged==="true"){

        toggle.dataset.dragged="false";

        return;
    }

    minimized=!minimized;

    gui.classList.toggle(
        "pgMini",
        minimized
    );

};


// ==============================
// ARRASTAR BOTÃO
// ==============================

let toggleDragging=false;
let toggleMoved=false;
let toggleOffsetX=0;
let toggleOffsetY=0;


toggle.addEventListener(
    "mousedown",
    event=>{

        toggleDragging=true;
        toggleMoved=false;

        toggleOffsetX=
            event.clientX-
            toggle.offsetLeft;

        toggleOffsetY=
            event.clientY-
            toggle.offsetTop;

        event.preventDefault();

    }
);


document.addEventListener(
    "mousemove",
    event=>{

        if(!toggleDragging)return;

        toggleMoved=true;

        toggle.style.left=
            event.clientX-
            toggleOffsetX+
            "px";

        toggle.style.top=
            event.clientY-
            toggleOffsetY+
            "px";

        toggle.style.right="auto";
        toggle.style.bottom="auto";

    }
);


document.addEventListener(
    "mouseup",
    ()=>{

        if(!toggleDragging)return;

        if(toggleMoved){

            toggle.dataset.dragged="true";

        }

        toggleDragging=false;

    }
);


// ==============================
// ARRASTAR NO CELULAR
// ==============================

toggle.addEventListener(
    "touchstart",
    event=>{

        const touch=
            event.touches[0];

        toggleDragging=true;
        toggleMoved=false;

        toggleOffsetX=
            touch.clientX-
            toggle.offsetLeft;

        toggleOffsetY=
            touch.clientY-
            toggle.offsetTop;

    },
    {passive:true}
);


document.addEventListener(
    "touchmove",
    event=>{

        if(!toggleDragging)return;

        const touch=
            event.touches[0];

        toggleMoved=true;

        toggle.style.left=
            touch.clientX-
            toggleOffsetX+
            "px";

        toggle.style.top=
            touch.clientY-
            toggleOffsetY+
            "px";

        toggle.style.right="auto";
        toggle.style.bottom="auto";

    },
    {passive:true}
);


document.addEventListener(
    "touchend",
    ()=>{

        if(!toggleDragging)return;

        if(toggleMoved){

            toggle.dataset.dragged="true";

        }

        toggleDragging=false;

    }
);


// ==============================
// ARRASTAR GUI
// ==============================

$("pgHead").addEventListener(
    "mousedown",
    event=>{

        dragging=true;

        offsetX=
            event.clientX-
            gui.offsetLeft;

        offsetY=
            event.clientY-
            gui.offsetTop;

        event.preventDefault();

    }
);


document.addEventListener(
    "mousemove",
    event=>{

        if(!dragging)return;

        gui.style.left=
            event.clientX-
            offsetX+
            "px";

        gui.style.top=
            event.clientY-
            offsetY+
            "px";

        gui.style.transform=
            "scale(1)";

    }
);


document.addEventListener(
    "mouseup",
    ()=>{

        dragging=false;

    }
);


// ==============================
// ARRASTAR GUI CELULAR
// ==============================

let touchDragging=false;
let touchOffsetX=0;
let touchOffsetY=0;


$("pgHead").addEventListener(
    "touchstart",
    event=>{

        const touch=
            event.touches[0];

        touchDragging=true;

        touchOffsetX=
            touch.clientX-
            gui.offsetLeft;

        touchOffsetY=
            touch.clientY-
            gui.offsetTop;

    },
    {passive:true}
);


document.addEventListener(
    "touchmove",
    event=>{

        if(!touchDragging)return;

        const touch=
            event.touches[0];

        gui.style.left=
            touch.clientX-
            touchOffsetX+
            "px";

        gui.style.top=
            touch.clientY-
            touchOffsetY+
            "px";

        gui.style.transform=
            "scale(1)";

    },
    {passive:true}
);


document.addEventListener(
    "touchend",
    ()=>{

        touchDragging=false;

    }
);


// ==============================
// ESC / ALT / CTRL
// ==============================

function toggleHiddenMode(){

    hidden=!hidden;

    if(hidden){

        gui.style.display="none";
        toggle.style.display="none";
        notifyBox.style.display="none";

        document.body.style.filter="none";

    }else{

        gui.style.display="";
        toggle.style.display="";
        notifyBox.style.display="";

        document.body.style.filter=
            "invert(1) hue-rotate(180deg)";

    }

}


document.addEventListener(
    "keydown",
    event=>{

        if(event.key==="Escape"){

            minimized=!minimized;

            gui.classList.toggle(
                "pgMini",
                minimized
            );

        }

        if(event.key==="Alt"){

            toggleHiddenMode();

        }

    }
);


// ==============================
// SCROLL / BOTÃO CENTRAL
// ==============================

document.addEventListener(
    "mousedown",
    event=>{

        if(event.button!==1)return;

        event.preventDefault();

        toggleHiddenMode();

    }
);

})();
