// ==============================
// BOTÃO FLUTUANTE
// ==============================

const toggle=document.createElement("div");

toggle.id="pgToggle";

toggle.innerHTML=`

<img src="https://media.tenor.com/m11vauEEbcUAAAAM/meow-neko-arc.gif">

`;

document.body.appendChild(toggle);

// ==============================
// NOTIFICAÇÃO
// ==============================

const notifyBox=document.createElement("div");

notifyBox.id="pgNotify";

notifyBox.textContent="Feito!!";

document.body.appendChild(notifyBox);

const $=id=>document.getElementById(id);

// ==============================
// NOTIFY
// ==============================

let notifyTimer=null;

function notify(text="Feito!!",ms=1800){

    notifyBox.textContent=text;

    notifyBox.style.opacity="1";

    notifyBox.style.transform=
        "translateX(-50%) translateY(0)";

    clearTimeout(notifyTimer);

    notifyTimer=setTimeout(()=>{

        notifyBox.style.opacity="0";

        notifyBox.style.transform=
            "translateX(-50%) translateY(-20px)";

    },ms);
}

// ==============================
// HELPERS
// ==============================

const store={

    get:(k,d=null)=>{
        try{
            const v=localStorage.getItem("pgia."+k);
            return v===null?d:v;
        }catch{return d;}
    },

    set:(k,v)=>{
        try{localStorage.setItem("pgia."+k,v);}catch{}
    },

    del:(k)=>{
        try{localStorage.removeItem("pgia."+k);}catch{}
    }

};

function normalize(s){
    return (s||"")
        .toLowerCase()
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g,"")
        .replace(/[^\w\s]/g," ")
        .replace(/\s+/g," ")
        .trim();
}

// ==============================
// LER PÁGINA
// ==============================

function readPage(){

    const clone=
        document.body.cloneNode(true);

    [
        "#pgFloat",
        "#pgToggle",
        "#pgNotify",
        "script",
        "style",
        "noscript",
        "svg",
        "iframe"
    ].forEach(sel=>{

        clone
        .querySelectorAll(sel)
        .forEach(e=>e.remove());

    });

    return (clone.innerText||"")
        .replace(/\n{3,}/g,"\n\n")
        .trim()
        .slice(0,48000);
}

// ==============================
// COLETAR CLICÁVEIS
// ==============================

function getClickableCandidates(){

    const selectors=[
        "button","[role=button]","[role=radio]","[role=option]",
        "label","a[href]",
        "input[type=radio]","input[type=checkbox]",
        "input[type=submit]","input[type=button]",
        "li[onclick]","div[onclick]","span[onclick]"
    ];

    const found=new Set();

    for(const sel of selectors){

        document.querySelectorAll(sel).forEach(el=>{

            if(el.closest("#pgFloat, #pgToggle, #pgNotify"))return;
            if(el.disabled)return;

            const r=el.getBoundingClientRect();

            if(r.width<4||r.height<4)return;

            const s=getComputedStyle(el);

            if(s.display==="none"||
               s.visibility==="hidden"||
               s.opacity==="0")return;

            found.add(el);

        });

    }

    return [...found];
}

// ==============================
// CLICAR
// ==============================

function doClick(el){

    try{

        el.scrollIntoView({behavior:"smooth",block:"center"});

        const rect=el.getBoundingClientRect();

        const cx=rect.left+rect.width/2;
        const cy=rect.top+rect.height/2;

        if(el.tagName==="INPUT"){

            try{el.click();return true;}catch{}

        }

        ["pointerdown","mousedown","pointerup","mouseup","click"]
        .forEach(type=>{

            el.dispatchEvent(new MouseEvent(type,{

                bubbles:true,
                cancelable:true,
                view:window,
                clientX:cx,
                clientY:cy,
                button:0

            }));

        });

        if(typeof el.click==="function"){

            try{el.click();}catch{}

        }

        return true;

    }catch{return false;}

}

// ==============================
// ENCONTRAR E CLICAR
// ==============================

function clickAnswer(answerText){

    const target=normalize(answerText);

    if(!target)return false;

    const candidates=getClickableCandidates();

    if(!candidates.length)return false;

    const targetTokens=
        target.split(" ").filter(t=>t.length>2);

    let best=null;
    let bestScore=0;

    for(const el of candidates){

        let txt=
            el.innerText||
            el.value||
            el.getAttribute("aria-label")||"";

        if(el.tagName==="INPUT"&&el.id){

            const lbl=
                document.querySelector(
                    `label[for="${CSS.escape(el.id)}"]`
                );

            if(lbl)txt=lbl.innerText;

        }

        const norm=normalize(txt);

        if(!norm)continue;

        if(norm===target){

            doClick(el);
            return true;

        }

        let score=0;

        if(norm.includes(target))score+=100;
        if(target.includes(norm))score+=80;

        if(targetTokens.length){

            const tokens=
                norm.split(" ").filter(t=>t.length>2);

            const hits=
                targetTokens.filter(t=>tokens.includes(t)).length;

            score+=(hits/targetTokens.length)*70;

        }

        if(score>bestScore){

            bestScore=score;
            best=el;

        }

    }

    if(best&&bestScore>=55){

        doClick(best);
        return true;

    }

    return false;
}

// ==============================
// EXTRAIR RESPOSTA
// ==============================

function extractAnswer(text){

    if(!text)return "";

    const m=
        text.match(/RESPOSTA\s*[:\-]\s*(.+?)(?:\n|$)/i);

    if(m&&m[1]){

        let a=m[1].trim();

        a=a.replace(/^["'`*\-•\s]+|["'`*\s]+$/g,"");
        a=a.replace(/^\(?[a-z]\)?[\s.\-:]+/i,"");
        a=a.replace(/^\d+[\s.\-:]+/,"");

        return a.trim();

    }

    const line=
        text.split("\n")
            .map(l=>l.trim())
            .filter(Boolean)[0]||"";

    return line;
}

// ==============================
// PROCURAR RESPOSTA
// ==============================

apiKey=store.get("apikey","");

let busy=false;

$("pgGo").onclick=async()=>{

    if(busy)return;
    busy=true;

    toggle.classList.remove("pgOk","pgErr");
    toggle.classList.add("pgWorking");

    $("pgGo").disabled=true;
    $("pgGo").textContent="PROCURANDO...";

    try{

        // 1) lê a página
        pageText=readPage();

        if(!pageText||pageText.length<30){

            throw new Error(
                "Não encontrei conteúdo na página."
            );

        }

        notify("Página lida! Consultando IA...",2200);

        // 2) api key
        if(!apiKey){

            apiKey=prompt(
                "Cole sua chave do OpenRouter:"
            );

            if(!apiKey){
                throw new Error("Chave não informada.");
            }

            store.set("apikey",apiKey);

        }

        $("pgAnswer").value=
            "Enviando conteúdo para a IA...";

        // 3) montar pergunta
        const extra=$("pgQuestion").value.trim();

        const pergunta=
            "Analise o conteúdo da página e responda a questão. "+
            "Na PRIMEIRA LINHA, informe qual alternativa é a correta, "+
            "usando o texto EXATO da alternativa, no formato:\n"+
            "RESPOSTA: <texto exato da alternativa>\n"+
            "Depois, se quiser, explique brevemente.\n\n"+
            (extra?("PERGUNTA/OBSERVAÇÃO DO USUÁRIO:\n"+extra+"\n\n"):"");

        // 4) chamar IA
        const res=await fetch(
            "https://openrouter.ai/api/v1/chat/completions",
            {
                method:"POST",
                headers:{
                    "Authorization":"Bearer "+apiKey,
                    "Content-Type":"application/json"
                },
                body:JSON.stringify({

                    model:"openrouter/free",

                    messages:[
                        {
                            role:"system",
                            content:
                                "Você é um assistente que analisa páginas da internet. Responda em português, de forma clara e objetiva."
                        },
                        {
                            role:"user",
                            content:
                                pergunta+
                                "\n\nCONTEÚDO DA PÁGINA:\n"+
                                pageText
                        }
                    ]

                })
            }
        );

        if(!res.ok){

            if(res.status===401||res.status===403){

                apiKey="";
                store.del("apikey");

            }

            let msg="HTTP "+res.status;

            try{
                const j=await res.json();
                msg=j?.error?.message||msg;
            }catch{}

            throw new Error(msg);

        }

        const dados=await res.json();

        const resposta=
            dados?.choices?.[0]?.message?.content||"";

        if(!resposta){

            throw new Error(
                "A IA não retornou uma resposta."
            );

        }

        $("pgAnswer").value=resposta;

        // 5) extrair e clicar
        const alvo=extractAnswer(resposta);

        if(!alvo){

            throw new Error(
                "Não consegui extrair a resposta."
            );

        }

        await new Promise(r=>setTimeout(r,200));

        const clicou=clickAnswer(alvo);

        toggle.classList.remove("pgWorking");

        if(clicou){

            toggle.classList.add("pgOk");
            notify("✓ "+alvo.slice(0,90),3200);

        }else{

            toggle.classList.add("pgErr");
            notify(
                "Resposta: "+alvo.slice(0,120)+
                " — não achei p/ clicar",
                4500
            );

        }

    }catch(erro){

        toggle.classList.remove("pgWorking");
        toggle.classList.add("pgErr");

        $("pgAnswer").value=
            "ERRO:\n\n"+erro.message;

        notify("Erro: "+erro.message,3800);

        console.error("[PortugaIA]",erro);

    }finally{

        $("pgGo").disabled=false;
        $("pgGo").textContent="PROCURAR RESPOSTA";

        busy=false;

        setTimeout(
            ()=>toggle.classList.remove("pgOk","pgErr"),
            2600
        );

    }

};

// ==============================
// MINIMIZAR
// ==============================

toggle.onclick=()=>{

    if(toggle.dataset.dragged==="true"){

        toggle.dataset.dragged="false";
        return;

    }

    minimized=!minimized;

    gui.classList.toggle("pgMini",minimized);

};

// ==============================
// ARRASTAR BOTÃO (mouse)
// ==============================

let toggleDragging=false;
let toggleMoved=false;
let toggleOffsetX=0;
let toggleOffsetY=0;

toggle.addEventListener("mousedown",event=>{

    toggleDragging=true;
    toggleMoved=false;

    toggleOffsetX=event.clientX-toggle.offsetLeft;
    toggleOffsetY=event.clientY-toggle.offsetTop;

    event.preventDefault();

});

document.addEventListener("mousemove",event=>{

    if(!toggleDragging)return;

    toggleMoved=true;

    toggle.style.left=
        event.clientX-toggleOffsetX+"px";

    toggle.style.top=
        event.clientY-toggleOffsetY+"px";

    toggle.style.right="auto";
    toggle.style.bottom="auto";

});

document.addEventListener("mouseup",()=>{

    if(!toggleDragging)return;

    if(toggleMoved){

        toggle.dataset.dragged="true";

    }

    toggleDragging=false;

});

// ==============================
// ARRASTAR BOTÃO (touch)
// ==============================

toggle.addEventListener("touchstart",event=>{

    const touch=event.touches[0];

    toggleDragging=true;
    toggleMoved=false;

    toggleOffsetX=touch.clientX-toggle.offsetLeft;
    toggleOffsetY=touch.clientY-toggle.offsetTop;

},{passive:true});

document.addEventListener("touchmove",event=>{

    if(!toggleDragging)return;

    const touch=event.touches[0];

    toggleMoved=true;

    toggle.style.left=
        touch.clientX-toggleOffsetX+"px";

    toggle.style.top=
        touch.clientY-toggleOffsetY+"px";

    toggle.style.right="auto";
    toggle.style.bottom="auto";

},{passive:true});

document.addEventListener("touchend",()=>{

    if(!toggleDragging)return;

    if(toggleMoved){

        toggle.dataset.dragged="true";

    }

    toggleDragging=false;

});

// ==============================
// ARRASTAR PAINEL (mouse)
// ==============================

$("pgHead").addEventListener("mousedown",event=>{

    dragging=true;

    offsetX=event.clientX-gui.offsetLeft;
    offsetY=event.clientY-gui.offsetTop;

    event.preventDefault();

});

document.addEventListener("mousemove",event=>{

    if(!dragging)return;

    gui.style.left=
        event.clientX-offsetX+"px";

    gui.style.top=
        event.clientY-offsetY+"px";

    gui.style.transform="scale(1)";

});

document.addEventListener("mouseup",()=>{

    dragging=false;

});

// ==============================
// ARRASTAR PAINEL (touch)
// ==============================

let touchDragging=false;
let touchOffsetX=0;
let touchOffsetY=0;

$("pgHead").addEventListener("touchstart",event=>{

    const touch=event.touches[0];

    touchDragging=true;

    touchOffsetX=touch.clientX-gui.offsetLeft;
    touchOffsetY=touch.clientY-gui.offsetTop;

},{passive:true});

document.addEventListener("touchmove",event=>{

    if(!touchDragging)return;

    const touch=event.touches[0];

    gui.style.left=
        touch.clientX-touchOffsetX+"px";

    gui.style.top=
        touch.clientY-touchOffsetY+"px";

    gui.style.transform="scale(1)";

},{passive:true});

document.addEventListener("touchend",()=>{

    touchDragging=false;

});

// ==============================
// ESC / ALT / BOTÃO DO MEIO
// ==============================

function toggleHiddenMode(){

    hidden=!hidden;

    if(hidden){

        gui.style.display="none";
        toggle.style.display="none";
        notifyBox.style.display="none";

    }else{

        gui.style.display="";
        toggle.style.display="";
        notifyBox.style.display="";

    }

}

document.addEventListener("keydown",event=>{

    if(event.key==="Escape"){

        minimized=!minimized;

        gui.classList.toggle("pgMini",minimized);

    }

    if(event.key==="Alt"){

        toggleHiddenMode();

    }

    if(event.altKey&&(event.key==="q"||event.key==="Q")){

        event.preventDefault();

        $("pgGo").click();

    }

});

document.addEventListener("mousedown",event=>{

    if(event.button!==1)return;

    event.preventDefault();

    toggleHiddenMode();

});

})();