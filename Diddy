   API KEY
========================= */

const store={
    get:(key,fallback=null)=>{
        try{
            const value=localStorage.getItem("pgia."+key);
            return value===null?fallback:value;
        }catch{return fallback;}
    },
    set:(key,value)=>{
        try{localStorage.setItem("pgia."+key,value);}catch{}
    },
    del:key=>{
        try{localStorage.removeItem("pgia."+key);}catch{}
    }
};

apiKey=store.get("apikey","");

